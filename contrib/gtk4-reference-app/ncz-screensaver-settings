def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="ncz-screensaver-settings")
    p.add_argument("--dump", action="store_true", help="Print settings JSON and exit")
    p.add_argument(
        "--self-test",
        action="store_true",
        help="Drive the live UI, assert GSettings, exit 0/1/2",
    )
    p.add_argument(
        "--gtk-smoke",
        action="store_true",
        help=(
            "Headless GTK4 smoke test: build the window and the per-screensaver "
            "options dialog, assert the catalogue loaded, exit 0/1"
        ),
    )
    return p.parse_args(argv)


def make_app() -> Gio.Application:
    """A Gtk.Application, Adwaita-backed when libadwaita is installed."""
    cls = Adw.Application if _HAVE_ADW else Gtk.Application
    return cls.new(APP_ID, Gio.ApplicationFlags.FLAGS_NONE)


def _run_error_window(app: Gio.Application, title: str, description: str) -> int:
    """Show a friendly status page when launched without a usable schema."""

    def on_activate(_a: Gio.Application) -> None:
        win = Gtk.ApplicationWindow.new(app)
        win.set_title("Screensaver & Lock")
        win.set_default_size(520, 360)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(Gtk.HeaderBar())
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        text.set_margin_top(36)
        text.set_margin_bottom(36)
        text.set_margin_start(24)
        text.set_margin_end(24)
        heading = Gtk.Label(label=title)
        heading.add_css_class("title-2")
        body = Gtk.Label(label=description)
        body.set_wrap(True)
        body.set_justify(Gtk.Justification.CENTER)
        text.append(heading)
        text.append(body)
        box.append(text)
        win.set_content(box)
        win.present()

    app.connect("activate", on_activate)
    return app.run(None)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    settings = open_settings()
    if settings is None:
        if args.dump:
            sys.stdout.write(json.dumps({"error": "schema-missing"}) + "\n")
            return 1
        return _run_error_window(
            make_app(),
            "GSettings schema missing",
            "The dev.ncz.screensaver schema is not installed.",
        )

    if args.dump:
        raw = load_catalog()
        catalog = build_catalog_view(raw, hack_dirs())
        model = build_model(settings, raw, hack_dirs())
        sys.stdout.write(
            json.dumps(read_dump(settings, catalog, model), indent=2) + "\n"
        )
        return 0

    if args.self_test:
        return run_self_test()

    if args.gtk_smoke:
        return run_gtk_smoke()

    return ScreensaverApp(settings).run(None)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
