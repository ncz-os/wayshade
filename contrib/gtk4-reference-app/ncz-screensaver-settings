class ScreensaverApp(Adw.Application if _HAVE_ADW else Gtk.Application):  # type: ignore[misc]
    """One window, the settings UI; Adwaita when available, plain GTK4 else."""

    def __init__(self, settings: Gio.Settings, autocalibrate: bool = True) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self._settings = settings
        self._autocalibrate = autocalibrate

    def do_activate(self) -> None:  # type: ignore[override]
        make_window(self, self._settings, autocalibrate=self._autocalibrate).present()


