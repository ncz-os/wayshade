# ---------------------------------------------------------------------------
# Settings-schema helpers
# ---------------------------------------------------------------------------


def _installed_schema() -> Gio.SettingsSchema | None:
    """The dev.ncz.screensaver schema from the default schema source, or None."""
    try:
        src = Gio.SettingsSchemaSource.get_default()
    except GLib.Error:
        return None
    if src is None:
        return None
    return src.lookup(SCHEMA_ID, True)


def _key_range(key: str) -> tuple[str, object] | None:
    """(kind, payload) of a schema key's range, or None.

    GSettings reports a key with `<choices>` (and a key with an enum type) as
    ("enum", the declared strings in schema order), a bounded numeric key as
    ("range", (lower, upper)) and anything else - booleans, unbounded numbers,
    plain strings - with no usable range. This is the only introspection API
    available across the GLib versions this app supports.

    The payload comes back as a GLib.Variant on some PyGObject builds and as an
    already-unpacked list/tuple on others, so callers use _as_sequence().
    """
    schema = _installed_schema()
    if schema is None:
        return None
    key_schema = schema.get_key(key)
    if key_schema is None:
        return None
    found = key_schema.get_range()
    if not found or found[0] is None:
        return None
    return str(found[0]), found[1]


def _as_sequence(payload: object) -> tuple[object, ...] | None:
    """Normalize a GLib.Variant payload to a tuple, or None if it is not one."""
    unpack = getattr(payload, "unpack", None)
    if callable(unpack):
        payload = unpack()
    if isinstance(payload, (list, tuple)):
        return tuple(payload)
    return None


def schema_choices(
    key: str, fallback: tuple[str, ...], skip: frozenset[str] = frozenset()
) -> tuple[str, ...]:
    """Declared values of a string or enum key, in schema order.

    This is what keeps the chooser from drifting away from the engine: the
    mode, GPU-pool and colour lists are whatever the installed schema says they
    are. `fallback` is only used when the schema is not installed yet, so
    --dump still produces a usable document on a machine that never ran the
    engine. `skip` drops values the engine keeps only for backward
    compatibility - they must stay readable but must not be offered as a
    choice, or the user would see "weak" twice under two names.
    """
    found = _key_range(key)
    if not found or found[0] != "enum":
        return fallback
    values = _as_sequence(found[1])
    if not values:
        return fallback
    kept = tuple(str(v) for v in values if str(v) not in skip)
    return kept or fallback


def schema_range(key: str, fallback: tuple[float, float]) -> tuple[float, float]:
    """(lower, upper) of a numeric key, so the spin rows follow the schema."""
    found = _key_range(key)
    if not found or found[0] != "range":
        return fallback
    bounds = _as_sequence(found[1])
    if bounds is None or len(bounds) != 2:
        return fallback
    try:
        lo, hi = float(bounds[0]), float(bounds[1])
    except (TypeError, ValueError):
        return fallback
    return (lo, hi) if hi > lo else fallback


def mode_nicks() -> tuple[str, ...]:
    """Mode ids the installed engine understands."""
    return schema_choices("mode", MODE_NICKS_FALLBACK)


def pool_nicks() -> tuple[str, ...]:
    """GPU-pool ids the installed engine understands, minus legacy aliases."""
    return schema_choices(
        "pool-gpu-class", POOL_NICKS_FALLBACK, frozenset(POOL_ALIASES)
    )


def color_nicks() -> tuple[str, ...]:
    """Black hole colour-mode nicks the installed engine understands."""
    return schema_choices("blackhole-color-mode", COLOR_NICKS_FALLBACK)


