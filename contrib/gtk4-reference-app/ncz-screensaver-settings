def open_settings() -> Gio.Settings | None:
    """Open the dev.ncz.screensaver schema; None if missing.

    Gio.Settings.new() aborts the process when the schema is missing, so
    look up the schema first via Gio.SettingsSchemaSource.
    """
    try:
        src = Gio.SettingsSchemaSource.get_default()
    except GLib.Error as e:
        sys.stderr.write(f"settings: no schema source: {e}\n")
        return None
    if src is None:
        sys.stderr.write("settings: no default schema source\n")
        return None
    schema = src.lookup(SCHEMA_ID, True)
    if schema is None:
        sys.stderr.write(f"settings: schema '{SCHEMA_ID}' not installed\n")
        return None
    try:
        return Gio.Settings.new_full(schema, None, None)
    except GLib.Error as e:
        sys.stderr.write(f"settings: cannot open '{SCHEMA_ID}': {e}\n")
        return None


def build_model(settings: Gio.Settings, catalog: list[dict], dirs: list[str]) -> dict:
    """Everything the window and --dump derive from the launcher CLI."""
    installed = {r["id"]: is_installed(r["id"], dirs) for r in catalog}
    overlay = load_overlay()
    show_all = settings.get_boolean("show-all-hacks")
    groups = compute_groups(catalog, overlay, installed, load_broken(), show_all)
    status = cli_json(["status", "--json"])
    gpus = cli_json(["gpus", "--json"])
    gpus = gpus if isinstance(gpus, list) else None
    return {
        "groups": groups,
        "status": status if isinstance(status, dict) else None,
        "gpus": gpus,
        "show_all_switch": any(g["expander"] for g in groups),
        "installed": installed,
    }


def read_dump(
    settings: Gio.Settings, catalog_view: list[dict], model: dict | None = None
) -> dict:
    """Compose the JSON shape required by --dump."""
    pool = settings.get_strv("random-hacks")
    model = model or {}
    stored_gpu = settings.get_string("gpu-offload")
    return {
        "mode": settings.get_string("mode"),
        "hack_id": settings.get_string("hack-id"),
        "random_hacks": pool,
        "idle_minutes": settings.get_int("hack-idle-delay") // 60,
        "catalog": [
            {
                "id": r["id"],
                "title": r["title"],
                "group": r["group"],
                "installed": r["installed"],
                "enabled": (not pool) or r["id"] in pool,
            }
            for r in catalog_view
        ],
        "color": settings.get_string("blackhole-color-mode"),
        "gpu_offload": stored_gpu,
        "gpu_choices": [
            {"value": v, "label": lbl}
            for v, lbl in gpu_choices(model.get("gpus"), stored_gpu)
        ],
        "pool_gpu_class": normalize_pool(settings.get_string("pool-gpu-class")),
        "pool_gpu_class_stored": settings.get_string("pool-gpu-class"),
        "pool_choices": [{"value": n, "label": POOL_LABEL[n]} for n in POOL_NICKS],
        "show_all_hacks": settings.get_boolean("show-all-hacks"),
        "show_all_switch": model.get("show_all_switch", False),
        "gpu_class_summary": class_summary(model.get("status"), model.get("gpus")),
        "gpu_verdict": (
            (model.get("status") or {}).get("gpu_verdict", "")
            if isinstance(model.get("status"), dict)
            else ""
        ),
        "prime_offload": prime_offload_text(model.get("status")),
        "groups": [
            {
                "title": g["title"],
                "collapsed": g["collapsed"],
                "rows": [
                    {k: r[k] for k in ("id", "flagged", "badge", "subtitle")}
                    for r in g["rows"]
                ],
            }
            for g in model.get("groups", [])
        ],
        "render": [
            settings.get_string("render-scale-mode"),
            settings.get_double("render-scale"),
            settings.get_int("max-render-height"),
        ],
    }


# ---------------------------------------------------------------------------
# Subprocess helpers
# ---------------------------------------------------------------------------


def run_cli_async(args: list[str], done=None) -> None:
    """Run a launcher command in the background; done(text) gets its output."""
    try:
        proc = Gio.Subprocess.new(
            cli_cmd() + args,
            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
        )
    except GLib.Error as e:
        if done:
            done(str(e))
        return

    def finished(p: Gio.Subprocess, res: Gio.AsyncResult) -> None:
        try:
            _ok, out, _err = p.communicate_utf8_finish(res)
        except GLib.Error as e:
            out = str(e)
        if done:
            done((out or "").strip())

    proc.communicate_utf8_async(None, None, finished)


def run_subprocess(args: list[str]) -> None:
    """Run a `ncz-screensaver` command non-blocking via Gio.Subprocess."""
    flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
    try:
        proc = Gio.Subprocess.new(cli_cmd() + args[1:], flags)
    except GLib.Error as e:
        sys.stderr.write(f"spawn {args}: {e}\n")
        return
    # Drain pipes asynchronously so the child never blocks on full buffers.
    proc.communicate_utf8_async(None, None, None)


def preview_blackhole() -> None:
    run_subprocess(["ncz-screensaver", "preview", "blackhole_gles3", "--seconds", "20"])


def preview_hack(hack_id: str) -> None:
    run_subprocess(["ncz-screensaver", "preview", hack_id, "--seconds", "15"])


def stop_preview() -> None:
    run_subprocess(["ncz-screensaver", "stop"])


