def _value_in_schema(row: dict, value: str) -> bool:
    """True when `value` is a legal value for the option described by `row`."""
    kind = row["type"]
    if kind == "bool":
        return value in ("true", "false")
    if kind == "enum":
        return value in (row["choices"] or [row["default"]])
    if kind in ("int", "float"):
        try:
            lo, hi = float(row["min"] or 0), float(row["max"] or 100)
            num = float(value)
        except ValueError:
            return False
        return lo <= num <= hi
    return True


