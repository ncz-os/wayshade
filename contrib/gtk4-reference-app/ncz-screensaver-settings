        self._class_btn.connect("clicked", self._on_recalibrate)
        self._class_row.add_suffix(self._class_btn)
        grp.add(self._class_row)
        self._gpu_row = Adw.ComboRow.new()
        self._gpu_row.set_title("Screensaver GPU")
        self._gpu_row.set_subtitle(GPU_AUTO_HINT)
        self._gpu_row.set_model(Gtk.StringList.new([]))
        self._gpu_row.connect("notify::selected", self._on_gpu_changed)
        grp.add(self._gpu_row)
        # Read-only: plain-English description of the PRIME render-offload
        # policy. Created once; the subtitle is refreshed in _load_status.
        # Hidden only when the launcher is older than 0.7.11 and has no
        # explanation. Current launchers explain single-GPU layouts.
        # UX requirement, operator 2026-09-30.
        self._prime_row = Adw.ActionRow.new()
        self._prime_row.set_title("PRIME render offload")
        self._prime_row.set_visible(False)
        grp.add(self._prime_row)
