        self._color_model = Gtk.StringList.new([color_label(n) for n in color_nicks()])
        self._color_row.set_model(self._color_model)
        self._color_row.connect("notify::selected", self._on_color_changed)
        grp.add(self._color_row)

        preview_row = Adw.ActionRow.new()
