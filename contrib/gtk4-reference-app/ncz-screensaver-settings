        self._render_height_row.set_title("Maximum render height (advanced)")
        self._render_height_row.set_subtitle(
            "Pixels; 0 lets Auto decide (choose High for no cap)"
        )
        self._render_height_row.connect("changed", self._on_render_height_changed)
        grp.add(self._render_height_row)
        self._class_row = Adw.ActionRow.new()
        self._class_row.set_title("Graphics chips")
        self._class_btn = Gtk.Button.new_with_label("Recalibrate")
