def _has_display() -> bool:
    """Return True when a GTK display can be opened.

    Accepts the three backends a headless or non-Wayland session may have:
    Wayland (WAYLAND_DISPLAY), X11 (DISPLAY) and Broadway (GDK_BACKEND=broadway,
    which serves its own display and so sets neither of the other two).
    """
    if not (
        os.environ.get("WAYLAND_DISPLAY")
        or os.environ.get("DISPLAY")
        or "broadway" in os.environ.get("GDK_BACKEND", "")
    ):
        return False
    try:
        from gi.repository import Gdk  # noqa: WPS433

        Gtk.init()
        return Gdk.Display.get_default() is not None
    except Exception:  # noqa: BLE001
        return False


def run_self_test() -> int:
    """Drive the live UI via GLib timeouts and assert each step.

    Returns 0 on all-pass, 1 on any failure, 2 if no display is available.
    """
    settings = open_settings()
    if settings is None:
        print("FAIL schema: dev.ncz.screensaver not installed")
        return 1
    if not _has_display():
        return 2

    app = ScreensaverApp(settings, autocalibrate=False)

    # Snapshot every key we may touch so we can restore at the end.
    saved = {
        "mode": settings.get_string("mode"),
        "hack-id": settings.get_string("hack-id"),
        "random-hacks": settings.get_strv("random-hacks"),
        "hack-idle-delay": settings.get_int("hack-idle-delay"),
        "blackhole-color-mode": settings.get_string("blackhole-color-mode"),
    }

    results: list[tuple[str, bool]] = []
    state = {"step": 0}

    def first_installed_id() -> str | None:
        for row in load_catalog():
            if is_installed(row["id"], hack_dirs()):
                return row["id"]
        return None

    def win():
        w = app.get_active_window()
        assert w is not None, "self-test window not realized"
        return w

    def driver() -> bool:
        # Step 0: set mode to "random" through the UI path.
        if state["step"] == 0:
            w = win()
            nicks = mode_nicks()
            if "random" in nicks:
                w._mode_row.set_selected(nicks.index("random"))
            w._on_mode_changed(w._mode_row, None)
            results.append(
                (
                    "mode-set",
                    settings.get_string("mode") == "random",
                )
            )
            state["step"] = 1
            return True
        # Step 1: toggle the first installed hack's random-pool switch off
        # then on; verify both intermediate states.
        if state["step"] == 1:
            w = win()
            target_id = first_installed_id()
            if target_id is None or target_id not in w._rows_by_id:
                results.append(("pool-toggle", False))
            else:
                sw = w._rows_by_id[target_id]["switch"]
                sw.set_active(False)
                w._on_pool_toggled(sw, None, target_id)
                after_off = settings.get_strv("random-hacks")
                sw.set_active(True)
                w._on_pool_toggled(sw, None, target_id)
                after_on = settings.get_strv("random-hacks")
                results.append(
                    (
                        "pool-toggle",
                        target_id not in after_off
                        and (not after_on or target_id in after_on),  # [] = all enabled
                    )
                )
            state["step"] = 2
            return True
        # Step 2: change color to kipthorne then restore.
        if state["step"] == 2:
            w = win()
            nicks = getattr(w, "_color_nicks", list(color_nicks()))
            if "kipthorne" in nicks:
                w._color_row.set_selected(nicks.index("kipthorne"))
                w._on_color_changed(w._color_row, None)
            set_ok = settings.get_string("blackhole-color-mode") == "kipthorne"
            original = saved["blackhole-color-mode"]
            if original in nicks:
                w._color_row.set_selected(nicks.index(original))
                w._on_color_changed(w._color_row, None)
            restore_ok = settings.get_string("blackhole-color-mode") == original
            results.append(("color-set", set_ok))
            results.append(("color-restore", restore_ok))
            state["step"] = 3
            return True
        # Step 3: change the idle spin row and restore.
        if state["step"] == 3:
            w = win()
            saved_delay = saved["hack-idle-delay"]
            new_delay = saved_delay + 60 if saved_delay < 84000 else 60
            w._idle_row.set_value(new_delay // 60)
            w._on_idle_changed(w._idle_row)
            set_ok = settings.get_int("hack-idle-delay") == new_delay
            w._idle_row.set_value(saved_delay // 60)
            w._on_idle_changed(w._idle_row)
            restore_ok = settings.get_int("hack-idle-delay") == saved_delay
            results.append(("idle-set", set_ok))
            results.append(("idle-restore", restore_ok))
            state["step"] = 99
            return True
        return False

    GLib.timeout_add(50, driver)
    app.register(None)  # activate() needs a registered application
    app.activate()

    # Run the main loop until either the sequence finishes or 30 s elapse.
    deadline = time.monotonic() + 30.0
    context = GLib.MainContext.default()
    while time.monotonic() < deadline and state["step"] != 99:
        context.iteration(True)
        if len(results) >= 6:
            break

    # Restore everything we touched (last write wins in GSettings, so order is
    # irrelevant; use the snapshot).
    try:
        settings.set_strv("random-hacks", saved["random-hacks"])
        settings.set_string("blackhole-color-mode", saved["blackhole-color-mode"])
        settings.set_int("hack-idle-delay", saved["hack-idle-delay"])
        settings.set_string("hack-id", saved["hack-id"])
        settings.set_string("mode", saved["mode"])
    except GLib.Error as e:
        print(f"FAIL restore: {e}")

    failed = False
    for label, ok in results:
        print(f"{'PASS' if ok else 'FAIL'} {label}")
        failed = failed or not ok

    app.quit()
    return 1 if failed else 0


