    def _build_verify_group(self, page: Adw.PreferencesPage) -> None:
        grp = Adw.PreferencesGroup.new()
        grp.set_title("Detect black screensavers")
        page.add(grp)

        self._verify_row = Adw.SwitchRow.new()
        self._verify_row.set_title(
            "Treat a fully black frame as a failure and move to the next hack"
        )
        self._verify_row.connect("notify::active", self._on_verify_changed)
        grp.add(self._verify_row)

    def _build_hack_groups(self, page: Adw.PreferencesPage) -> None:
        """One Adw.PreferencesGroup per catalog group; rows are action rows."""
        self._catalog = load_catalog()
        self._dirs = hack_dirs()
        self._installed = {
            row["id"]: is_installed(row["id"], self._dirs) for row in self._catalog
        }

        model = build_model(self._settings, self._catalog, self._dirs)
        self._groups = model["groups"]
        self._by_id = {r["id"]: r for g in self._groups for r in g["rows"]}

        self._rows_by_id: dict[str, dict] = {}
        self._first_radio: Gtk.CheckButton | None = None

        if model["show_all_switch"]:
            sgrp = Adw.PreferencesGroup.new()
            page.add(sgrp)
            self._show_all_row = Adw.SwitchRow.new()
            self._show_all_row.set_title("Show all screensavers")
            self._show_all_row.set_subtitle(
                "Also list screensavers that may run poorly on this graphics chip"
            )
            self._show_all_row.connect("notify::active", self._on_show_all_changed)
            sgrp.add(self._show_all_row)
        else:
            self._show_all_row = None

        for g in self._groups:
            grp = Adw.PreferencesGroup.new()
            page.add(grp)
            if g["expander"]:
                exp = Adw.ExpanderRow.new()
                exp.set_title(f"{g['title']} ({len(g['rows'])})")
                exp.set_expanded(not g["collapsed"])
                grp.add(exp)
                self._flagged_expander = exp
                add = exp.add_row
            else:
                grp.set_title(f"{g['title']} ({len(g['rows'])})")
                add = grp.add

            for r in g["rows"]:
                installed = r["installed"]
                ar = Adw.ActionRow.new()
                ar.set_title(r["title"])
                ar.set_subtitle(r["subtitle"])
                if r["flagged"]:
                    badge = Gtk.Label.new(r["badge"])
                    badge.add_css_class("warning")
                    badge.set_valign(Gtk.Align.CENTER)
                    badge.set_tooltip_text(r["tooltip"])
                    ar.add_suffix(badge)
                    ar.set_tooltip_text(r["tooltip"])
                if r["issue"]:
                    flag = Gtk.Label.new(
                        "Known issue" if r["issue"] == "broken" else "Under review"
                    )
                    flag.add_css_class("warning")
                    flag.set_valign(Gtk.Align.CENTER)
                    flag.set_tooltip_text(r["issue_reason"])
                    ar.add_suffix(flag)
                if r.get("tier_label"):
                    # Minimum-GPU-class badge from the engine's tiers.tsv, so a
                    # glance says how heavy a screensaver is even before this
                    # machine has been calibrated.
                    tier = Gtk.Label.new(r["tier_label"])
                    tier.set_valign(Gtk.Align.CENTER)
                    tier.add_css_class("caption")
                    tier.add_css_class(TIER_BADGE_CSS[r["tier"]])
                    tier.set_tooltip_text(r.get("tier_tooltip", ""))
                    ar.add_suffix(tier)
                if not installed:
                    # Dim rows whose binary is missing; they cannot be previewed.
                    ar.add_css_class("dimmed")
                add(ar)

                # Prefix: a radio Gtk.CheckButton (group behavior) only shown
                # when the current mode is "one"; visibility is toggled in
                # _refresh_radio().
                radio = Gtk.CheckButton.new()
                radio.set_valign(Gtk.Align.CENTER)
                if self._first_radio is None:
                    self._first_radio = radio
                else:
                    radio.set_group(self._first_radio)
                radio.connect("toggled", self._on_radio_toggled, r["id"])
                ar.add_prefix(radio)

                # Suffix: a Gtk.Switch indicating membership in random-hacks.
                # When random-hacks is empty every switch shows on; toggling
                # one off materializes the full list minus that id, and if the
                # resulting list equals the whole catalog it is stored as [].
                sw = Gtk.Switch.new()
                sw.set_valign(Gtk.Align.CENTER)
                sw.connect("notify::active", self._on_pool_toggled, r["id"])
                if not installed:
                    sw.set_sensitive(False)
                ar.add_suffix(sw)

                btn = Gtk.Button.new_with_label("Preview")
                btn.set_valign(Gtk.Align.CENTER)
                if installed:
                    btn.connect("clicked", self._on_preview_clicked, r["id"])
                else:
                    btn.set_sensitive(False)
                ar.add_suffix(btn)

                schema = load_option_schema(r["id"]) if installed else []
                if schema:
                    obtn = Gtk.Button.new_with_label("Options")
                    obtn.set_valign(Gtk.Align.CENTER)
                    obtn.connect("clicked", self._on_options_clicked, r, schema)
                    ar.add_suffix(obtn)

                self._rows_by_id[r["id"]] = {"row": ar, "radio": radio, "switch": sw}

    # ---- settings signal wiring ------------------------------------------

    def _connect_settings_signals(self) -> None:
        # Listen to every key we read so external CLI/plugin writes refresh
        # the UI; the guard flag prevents our own writes from echoing back.
        for key in (
            "mode",
            "hack-id",
            "random-hacks",
            "hack-idle-delay",
            "cycle-delay",
            "lock-enabled",
            "lock-delay",
            "lock-on-suspend",
            "display-off-delay",
            "blackhole-color-mode",
            "verify-render",
            "gpu-offload",
            "pool-gpu-class",
            "show-all-hacks",
            "render-scale-mode",
            "render-scale",
            "max-render-height",
        ):
            self._settings.connect(f"changed::{key}", self._on_setting_changed)

    # ---- refresh helpers --------------------------------------------------

    def _refresh_from_settings(self) -> None:
        """Push current GSettings state into all widgets."""
        self._suppress_changed = True
        try:
            mode = self._settings.get_string("mode")
            self._mode_row.set_selected(
                _safe_index(getattr(self, "_mode_nicks", mode_nicks()), mode)
            )
            self._idle_row.set_value(self._settings.get_int("hack-idle-delay") // 60)
            self._cycle_row.set_value(self._settings.get_int("cycle-delay") // 60)
            self._lock_enabled_row.set_active(
                self._settings.get_boolean("lock-enabled")
            )
            self._lock_delay_row.set_value(self._settings.get_int("lock-delay") // 60)
            self._lock_on_suspend_row.set_active(
                self._settings.get_boolean("lock-on-suspend")
            )
            self._display_off_row.set_value(
                self._settings.get_int("display-off-delay") // 60
            )
            self._verify_row.set_active(self._settings.get_boolean("verify-render"))
            self._pool_row.set_selected(
                _safe_index(
                    list(pool_nicks()),
                    normalize_pool(self._settings.get_string("pool-gpu-class")),
                )
            )
            self._refresh_render()
            self._refresh_gpu_combo(self._settings.get_string("gpu-offload"))
            show_all = self._settings.get_boolean("show-all-hacks")
            if self._show_all_row is not None:
                self._show_all_row.set_active(show_all)
            if self._flagged_expander is not None:
                self._flagged_expander.set_expanded(show_all)
            self._refresh_color_combo(self._settings.get_string("blackhole-color-mode"))
            self._refresh_pool_switches()
            self._refresh_radio()
        finally:
            self._suppress_changed = False

    def _refresh_gpu_combo(self, stored: str) -> None:
        """Rebuild the GPU combo from the launcher's GPU list."""
        choices = gpu_choices(self._gpus, stored)
        self._gpu_values = [v for v, _l in choices]
        model = self._gpu_row.get_model()
        model.splice(0, model.get_n_items(), [lbl for _v, lbl in choices])
        self._gpu_row.set_selected(_safe_index(self._gpu_values, stored))

    def _load_status(self) -> None:
        """Fetch class/GPU info from the CLI and update the class row."""
        status = cli_json(["status", "--json"])
        gpus = cli_json(["gpus", "--json"])
        self._status = status if isinstance(status, dict) else None
        self._gpus = gpus if isinstance(gpus, list) else None
        self._class_row.set_subtitle(class_summary(self._status, self._gpus))
        # PRIME render offload row: current launchers explain unsupported
        # layouts; older launchers may omit the field.
        prime = prime_offload_text(self._status)
        if prime:
            self._prime_row.set_subtitle(prime)
            self._prime_row.set_visible(True)
        else:
            self._prime_row.set_subtitle("")
            self._prime_row.set_visible(False)

    def _reload_class(self) -> None:
        self._load_status()
        self._suppress_changed = True
        try:
            self._refresh_gpu_combo(self._settings.get_string("gpu-offload"))
        finally:
            self._suppress_changed = False

    def _maybe_autocalibrate(self) -> None:
        """Measure once at startup when the class is only a table guess."""
        st = self._status
        if st is None or st.get("running"):
            return
        if st.get("gpu_class_source") not in (None, "table"):
            return
        self._class_btn.set_sensitive(False)

        def done(_text: str) -> None:
            self._class_btn.set_sensitive(True)
            self._reload_class()

        run_cli_async(["calibrate"], done)

    def _on_recalibrate(self, _btn: Gtk.Button) -> None:
        self._class_btn.set_sensitive(False)

        def done(text: str) -> None:
            self._class_btn.set_sensitive(True)
            self._reload_class()
            lines = [ln for ln in text.splitlines() if ln.strip()]
            msg = lines[-1] if lines else "Calibration finished"
            self._toasts.add_toast(Adw.Toast.new(msg))

        run_cli_async(["calibrate", "--force"], done)

    def _on_show_all_changed(
        self, row: Adw.SwitchRow, pspec: GObject.ParamSpec
    ) -> None:
        self._write_bool("show-all-hacks", row, pspec)
        if self._flagged_expander is not None:
            self._flagged_expander.set_expanded(row.get_active())

    def _refresh_color_combo(self, current: str) -> None:
        """Rebuild the color combo entries; preserve the current value."""
        nicks = list(color_nicks())
        labels = [color_label(n) for n in nicks]
        if current not in nicks:
            nicks.append(current)
            labels.append(f"Custom: {current}")
        self._color_model.splice(0, self._color_model.get_n_items(), labels)
        self._color_row.set_selected(_safe_index(nicks, current))
        # Stash nick list for the change handler.
        self._color_nicks = nicks

    def _refresh_pool_switches(self) -> None:
        """Update each hack's random-pool switch from current random-hacks."""
        pool = set(self._settings.get_strv("random-hacks"))
        active = not pool  # Empty pool means every hack is "enabled".
        for hack_id, entry in self._rows_by_id.items():
            entry["switch"].set_active(active or hack_id in pool)

    def _refresh_radio(self) -> None:
        """Update the radio widget states and visibility."""
        mode = self._settings.get_string("mode")
        show_radio = mode == "one"
        current_hack = self._settings.get_string("hack-id")
        for hack_id, entry in self._rows_by_id.items():
            radio = entry["radio"]
            radio.set_visible(show_radio)
            radio.set_sensitive(show_radio and self._installed[hack_id])
            if hack_id == current_hack:
                radio.set_active(True)

    # ---- mode / color change handlers ------------------------------------

    def _write_combo(
        self,
        row: Adw.ComboRow,
        _pspec: GObject.ParamSpec,
        nicks: tuple[str, ...] | list[str],
        key: str,
    ) -> None:
        """Write the selected combo entry into a string GSettings key."""
        if self._suppress_changed:
            return
        idx = row.get_selected()
        if 0 <= idx < len(nicks):
            self._settings.set_string(key, nicks[idx])

    def _on_mode_changed(self, row: Adw.ComboRow, pspec: GObject.ParamSpec) -> None:
        self._write_combo(row, pspec, mode_nicks(), "mode")

    def _on_color_changed(self, row: Adw.ComboRow, pspec: GObject.ParamSpec) -> None:
        nicks = getattr(self, "_color_nicks", list(color_nicks()))
        self._write_combo(row, pspec, nicks, "blackhole-color-mode")

    # ---- integer/minute rows ---------------------------------------------

    def _write_int_minutes(self, key: str, row: Adw.SpinRow) -> None:
        """Write a minutes-bound SpinRow value into an integer GSettings key."""
        if self._suppress_changed:
            return
        self._settings.set_int(key, int(row.get_value()) * 60)

    def _write_bool(
        self, key: str, row: Adw.SwitchRow, _pspec: GObject.ParamSpec
    ) -> None:
        """Write a SwitchRow active state into a boolean GSettings key."""
        if self._suppress_changed:
            return
        self._settings.set_boolean(key, row.get_active())

    def _on_idle_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("hack-idle-delay", row)

    def _on_cycle_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("cycle-delay", row)

    def _on_lock_enabled_changed(
        self, row: Adw.SwitchRow, pspec: GObject.ParamSpec
    ) -> None:
        self._write_bool("lock-enabled", row, pspec)

    def _on_lock_delay_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("lock-delay", row)

    def _on_lock_on_suspend_changed(
        self, row: Adw.SwitchRow, pspec: GObject.ParamSpec
    ) -> None:
        self._write_bool("lock-on-suspend", row, pspec)

    def _on_display_off_changed(self, row: Adw.SpinRow) -> None:
        self._write_int_minutes("display-off-delay", row)

    def _render_state(self) -> tuple[str, float, int]:
        return (
            self._settings.get_string("render-scale-mode"),
            round(self._settings.get_double("render-scale"), 2),
            self._settings.get_int("max-render-height"),
        )

    def _refresh_render(self) -> None:
        state = self._render_state()
        idx = next(
            (i for i, p in enumerate(RENDER_PRESETS) if p[2] == state),
            len(RENDER_PRESETS),
        )
        self._render_row.set_selected(idx)
        self._render_height_row.set_value(state[2])

    def _on_render_changed(self, row: Adw.ComboRow, _pspec: GObject.ParamSpec) -> None:
        if self._suppress_changed:
            return
        idx = row.get_selected()
        if idx >= len(RENDER_PRESETS):
            return
        mode, scale, height = RENDER_PRESETS[idx][2]
        self._settings.set_string("render-scale-mode", mode)
        self._settings.set_double("render-scale", scale)
        self._settings.set_int("max-render-height", height)

    def _on_render_height_changed(self, row: Adw.SpinRow) -> None:
        if self._suppress_changed:
            return
        self._settings.set_int("max-render-height", int(row.get_value()))

    def _on_pool_class_changed(
        self, row: Adw.ComboRow, pspec: GObject.ParamSpec
    ) -> None:
        if self._suppress_changed:
            return
        idx = row.get_selected()
        pool = pool_nicks()
        if 0 <= idx < len(pool):
            self._settings.set_string("pool-gpu-class", pool[idx])

    def _on_gpu_changed(self, row: Adw.ComboRow, pspec: GObject.ParamSpec) -> None:
        if self._suppress_changed:
            return
        idx = row.get_selected()
        if 0 <= idx < len(self._gpu_values):
            self._settings.set_string("gpu-offload", self._gpu_values[idx])

    def _on_verify_changed(self, row: Adw.SwitchRow, pspec: GObject.ParamSpec) -> None:
        self._write_bool("verify-render", row, pspec)

    # ---- hack rows --------------------------------------------------------

    def _on_radio_toggled(self, btn: Gtk.CheckButton, hack_id: str) -> None:
        if self._suppress_changed:
            return
        if not btn.get_active():
            # Radio buttons fire toggled for both new and old; ignore the
            # deactivation so the choice isn't clobbered when another row
            # becomes active.
            return
        info = self._by_id.get(hack_id)
        if info and info["flagged"]:
            self._confirm_flagged(
                info,
                lambda: self._settings.set_string("hack-id", hack_id),
                self._revert_radio,
            )
            return
        self._settings.set_string("hack-id", hack_id)

    def _revert_radio(self) -> None:
        self._suppress_changed = True
        try:
            self._refresh_radio()
        finally:
            self._suppress_changed = False

    def _confirm_flagged(self, info: dict, proceed, cancel=None) -> None:
        """Ask before running a hack flagged as too heavy; user may proceed."""
        dlg = Adw.MessageDialog.new(self, "Run this screensaver?", flag_warning(info))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("run", "Run anyway")
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")

        def answered(_d: Adw.MessageDialog, resp: str) -> None:
            if resp == "run":
                proceed()
            elif cancel:
                cancel()

        dlg.connect("response", answered)
        dlg.present()

    def _on_pool_toggled(
        self, sw: Gtk.Switch, _pspec: GObject.ParamSpec, hack_id: str
    ) -> None:
        if self._suppress_changed:
            return
        all_ids = [r["id"] for r in self._catalog]
        current = self._settings.get_strv("random-hacks")
        # If the pool is empty today, toggling a switch materializes the full
        # set minus (or plus) the toggled id.
        if not current:
            new_pool = (
                list(all_ids)
                if sw.get_active()
                else [i for i in all_ids if i != hack_id]
            )
        else:
            new_pool = list(current)
            if sw.get_active() and hack_id not in new_pool:
                new_pool.append(hack_id)
            elif not sw.get_active() and hack_id in new_pool:
                new_pool.remove(hack_id)
        # Preserve catalog order; if the result covers everything store [].
        ordered = [i for i in all_ids if i in set(new_pool)]
        if set(ordered) == set(all_ids):
            self._settings.set_strv("random-hacks", [])
        else:
            self._settings.set_strv("random-hacks", ordered)

    def _on_options_clicked(
        self, _btn: Gtk.Button, hack: dict, schema: list[dict]
    ) -> None:
        OptionsDialog(self, self._settings, hack, schema).present()

    def _on_preview_clicked(self, _btn: Gtk.Button, hack_id: str) -> None:
        info = self._by_id.get(hack_id)
        if info and info["flagged"]:
            self._confirm_flagged(info, lambda: preview_hack(hack_id))
            return
        preview_hack(hack_id)

    def _on_search_changed(self, entry: Gtk.SearchEntry) -> None:
        needle = entry.get_text().strip().lower()
        for e in self._rows_by_id.values():
            title = e["row"].get_title().lower()
            e["row"].set_visible(not needle or needle in title)

    # ---- external "changed" handler ---------------------------------------

    def _on_setting_changed(self, _settings: Gio.Settings, _key: str) -> None:
        if self._suppress_changed:
            return
        self._refresh_from_settings()


def _safe_index(values: list[str], value: str) -> int:
    """Return the index of value in values, or 0 if absent."""
    try:
        return values.index(value)
    except ValueError:
        return 0


# ---------------------------------------------------------------------------
# Plain GTK4 window (used when libadwaita is not installed)
# ---------------------------------------------------------------------------


class GtkScreensaverWindow(Gtk.ApplicationWindow):
    """The chooser window built from plain GTK4 widgets only.

    libadwaita is a nicety, not a requirement: this window covers the whole
    settings surface that matters on a plain GTK4 session - mode, idle timeout,
    the screensaver list with its GPU-tier badges, the random-rotation pool and
    the per-screensaver options dialog - so the app is usable on KDE Plasma,
    on X11 and on images that ship GTK4 without gir1.2-adw-1. It deliberately
    offers fewer graphics knobs than the libadwaita window, which is the one
    to use on GNOME.
    """

    def __init__(
        self,
        app: Gtk.Application,
        settings: Gio.Settings,
        autocalibrate: bool = True,
    ) -> None:
        super().__init__(application=app)
        self._settings = settings
        self._autocalibrate = autocalibrate
        self._rows_by_id: dict[str, dict] = {}
        self._first_radio: Gtk.CheckButton | None = None
        self.set_title("Screensaver & Lock")
        self.set_default_size(720, 760)

        header = Gtk.HeaderBar()
        stop_btn = Gtk.Button.new_with_label("Stop preview")
        stop_btn.set_valign(Gtk.Align.CENTER)
        stop_btn.connect("clicked", lambda *_a: stop_preview())
        header.pack_end(stop_btn)
        calibrate = Gtk.Button.new_with_label("Measure this machine")
        calibrate.set_valign(Gtk.Align.CENTER)
        calibrate.set_tooltip_text(
            "Run the engine benchmark once so heavy screensavers are flagged"
        )
        calibrate.connect("clicked", self._on_recalibrate)
        self._class_btn = calibrate
        header.pack_start(calibrate)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(header)

        self._mode_nicks = mode_nicks()
        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        controls.set_margin_top(10)
        controls.set_margin_start(10)
        controls.set_margin_end(10)
        mode_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        mode_line.append(Gtk.Label(label="Mode", xalign=0.0))
        self._mode_row = Gtk.DropDown.new_from_strings(
            [mode_label(n) for n in self._mode_nicks]
        )
        self._mode_row.set_hexpand(True)
        self._mode_row.connect("notify::selected", self._on_mode_changed)
        mode_line.append(self._mode_row)
        controls.append(mode_line)

        idle_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        idle_line.append(Gtk.Label(label="Start after (minutes)", xalign=0.0))
        self._idle_row = Gtk.SpinButton.new_with_range(
            float(MINUTES_MIN), float(MINUTES_MAX), 1
        )
        self._idle_row.set_hexpand(True)
        self._idle_row.connect("value-changed", self._on_idle_changed)
        idle_line.append(self._idle_row)
        controls.append(idle_line)

        show_all = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        show_all.append(
            Gtk.Label(label="Also list screensavers that may stutter here", xalign=0.0)
        )
        self._show_all_switch = Gtk.Switch(halign=Gtk.Align.START)
        self._show_all_switch.connect("notify::active", self._on_show_all_changed)
        show_all.append(self._show_all_switch)
        controls.append(show_all)

        self._search = Gtk.SearchEntry()
        self._search.set_placeholder_text("Search screensavers")
        self._search.connect("search-changed", self._on_search_changed)
        controls.append(self._search)
        root.append(controls)

        self._list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self._list_box.set_margin_top(10)
        self._list_box.set_margin_bottom(10)
        self._list_box.set_margin_start(10)
        self._list_box.set_margin_end(10)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_child(self._list_box)
        root.append(scroll)
        # Gtk.Window has set_child(); Adw.ApplicationWindow has set_content().
        self.set_child(root)

        self._load_model()
        for key in (
            "mode",
            "hack-id",
            "random-hacks",
            "hack-idle-delay",
            "show-all-hacks",
        ):
            settings.connect("changed::" + key, self._on_setting_changed)
        self._refresh_from_settings()
        if autocalibrate:
            self._maybe_autocalibrate()

    # ---- model ------------------------------------------------------------

    def _load_model(self) -> None:
        self._catalog = load_catalog()
        self._dirs = hack_dirs()
        model = build_model(self._settings, self._catalog, self._dirs)
        self._model = model
        self._groups = model["groups"]
        child = self._list_box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self._list_box.remove(child)
            child = nxt
        self._rows_by_id = {}
        self._first_radio = None
        for g in self._groups:
            frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            caption = Gtk.Label(label=f"{g['title']} ({len(g['rows'])})")
            caption.set_xalign(0.0)
            caption.add_css_class("heading")
            frame.append(caption)
            for r in g["rows"]:
                frame.append(self._build_row(r))
            self._list_box.append(frame)
        self._refresh_radio()
        self._refresh_pool_switches()

    def _build_row(self, r: dict) -> Gtk.Widget:
        installed = r["installed"]
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.set_margin_bottom(2)

        radio = Gtk.CheckButton()
        radio.set_valign(Gtk.Align.CENTER)
        if self._first_radio is None:
            self._first_radio = radio
        else:
            radio.set_group(self._first_radio)
        radio.connect("toggled", self._on_radio_toggled, r["id"])
        row.append(radio)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        title = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        title.append(Gtk.Label(label=r["title"], xalign=0.0))
        if r.get("tier_label"):
            badge = Gtk.Label(label=r["tier_label"])
            badge.add_css_class("caption")
            badge.add_css_class(TIER_BADGE_CSS[r["tier"]])
            badge.set_tooltip_text(r.get("tier_tooltip", ""))
            title.append(badge)
        if r["flagged"]:
            warn = Gtk.Label(label=r["badge"])
            warn.add_css_class("warning")
            warn.set_tooltip_text(r["tooltip"])
            title.append(warn)
        text.append(title)
        sub = Gtk.Label(label=r["subtitle"], xalign=0.0)
        sub.add_css_class("dim-label")
        sub.set_wrap(True)
        text.append(sub)
        text.set_hexpand(True)
        row.append(text)

        sw = Gtk.Switch(valign=Gtk.Align.CENTER)
        sw.set_tooltip_text("Use this screensaver in the random rotation")
        sw.connect("notify::active", self._on_pool_toggled, r["id"])
        if not installed:
            sw.set_sensitive(False)
        row.append(sw)

        preview = Gtk.Button.new_with_label("Preview")
        preview.set_valign(Gtk.Align.CENTER)
        if installed:
            preview.connect("clicked", self._on_preview_clicked, r["id"])
        else:
            preview.set_sensitive(False)
        row.append(preview)

        schema = load_option_schema(r["id"]) if installed else []
        if schema:
            obtn = Gtk.Button.new_with_label("Options")
            obtn.set_valign(Gtk.Align.CENTER)
            obtn.connect("clicked", self._on_options_clicked, r, schema)
            row.append(obtn)

        if not installed:
            text.add_css_class("dimmed")
        self._rows_by_id[r["id"]] = {
            "row": row,
            "radio": radio,
            "switch": sw,
            "title": r["title"],
        }
        return row

    # ---- settings wiring --------------------------------------------------

    def _on_setting_changed(self, _s: Gio.Settings, key: str) -> None:
        if key in ("mode", "hack-id", "random-hacks", "show-all-hacks"):
            self._load_model()
        self._refresh_from_settings()

    def _refresh_from_settings(self) -> None:
        s = self._settings
        self._mode_row.set_selected(_safe_index(self._mode_nicks, s.get_string("mode")))
        self._idle_row.set_value(float(s.get_int("hack-idle-delay") // 60))
        self._show_all_switch.set_active(s.get_boolean("show-all-hacks"))

    def _refresh_radio(self) -> None:
        """The "one screensaver" radio is only meaningful in mode "one"."""
        one = self._settings.get_string("mode") == "one"
        for row in self._rows_by_id.values():
            row["radio"].set_visible(one)

    def _refresh_pool_switches(self) -> None:
        """Reflect random-hacks: empty means every screensaver is in the pool."""
        pool = self._settings.get_strv("random-hacks")
        for hid, row in self._rows_by_id.items():
            row["switch"].set_active((not pool) or hid in pool)

    def _on_mode_changed(self, row: Gtk.DropDown, _pspec) -> None:
        nicks = self._mode_nicks
        idx = row.get_selected()
        if 0 <= idx < len(nicks):
            self._settings.set_string("mode", nicks[idx])
        self._refresh_radio()

    def _on_idle_changed(self, row: Gtk.SpinButton) -> None:
        self._settings.set_int("hack-idle-delay", int(row.get_value()) * 60)

    def _on_show_all_changed(self, sw: Gtk.Switch, _p) -> None:
        self._settings.set_boolean("show-all-hacks", sw.get_active())
        self._load_model()

    def _on_radio_toggled(self, btn: Gtk.CheckButton, hack_id: str) -> None:
        if not btn.get_active():
            return
        if self._settings.get_string("mode") != "one":
            self._settings.set_string("mode", "one")
        self._settings.set_string("hack-id", hack_id)

    def _on_pool_toggled(self, sw: Gtk.Switch, _p, hack_id: str) -> None:
        pool = list(self._settings.get_strv("random-hacks"))
        if sw.get_active():
            if pool and hack_id not in pool:
                pool.append(hack_id)
        else:
            if pool and hack_id in pool:
                pool.remove(hack_id)
        # An empty list means "every screensaver", so materialise the full
        # catalogue minus the ones the user turned off.
        if not pool and not sw.get_active():
            pool = [i for i in self._rows_by_id if i != hack_id]
        self._settings.set_strv("random-hacks", pool)

    def _on_preview_clicked(self, _btn: Gtk.Button, hack_id: str) -> None:
        preview_hack(hack_id)

    def _on_options_clicked(
        self, _btn: Gtk.Button, r: dict, schema: list[dict]
    ) -> None:
        OptionsDialog(self, self._settings, r, schema).present()

    def _on_search_changed(self, entry: Gtk.SearchEntry) -> None:
        """Hide the rows whose id or title does not contain the needle."""
        needle = entry.get_text().strip().lower()
        for hid, info in self._rows_by_id.items():
            hay = f"{hid} {info['title']}".lower()
            info["row"].set_visible(not needle or needle in hay)

    def _maybe_autocalibrate(self) -> None:
        """Measure once at startup, the same rule the Adwaita window uses."""
        st = self._model.get("status")
        if not isinstance(st, dict) or st.get("running"):
            return
        if st.get("gpu_class_source") not in (None, "table"):
            return
        self._class_btn.set_sensitive(False)

        def done(_text: str) -> None:
            self._class_btn.set_sensitive(True)
            self._load_model()

        run_cli_async(["calibrate"], done)

    def _on_recalibrate(self, _btn: Gtk.Button) -> None:
        self._class_btn.set_sensitive(False)

        def done(_text: str) -> None:
            self._class_btn.set_sensitive(True)
            self._load_model()

        run_cli_async(["calibrate", "--force"], done)


def make_window(app, settings: Gio.Settings, autocalibrate: bool = True) -> Gtk.Window:
    """Build the best window this installation can show."""
    if _HAVE_ADW:
        return ScreensaverWindow(app, settings, autocalibrate=autocalibrate)
    return GtkScreensaverWindow(app, settings, autocalibrate=autocalibrate)


