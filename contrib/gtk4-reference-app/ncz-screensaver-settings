# ---------------------------------------------------------------------------


def run_gtk_smoke() -> int:
    """Build the window and the options dialog with no user interaction.

    This is the headless gate the packaging runs under Xvfb (or Broadway): it
    proves the GTK4 stack initialised, that the shipped catalogue loaded and
    that the per-screensaver options dialog can be opened and randomised, on
    both the libadwaita and the plain GTK4 code path. Exit 0 all-pass, 1 on
    any failure, 2 when there is no display to draw on.
    """
    settings = open_settings()
    if settings is None:
        print("FAIL schema: dev.ncz.screensaver not installed")
        return 1
    if not _has_display():
        print("SKIP no display")
        return 2

    catalog = load_catalog()
    results: list[tuple[str, bool]] = []
    results.append(("backend-adw" if _HAVE_ADW else "backend-gtk4", True))
    results.append(("catalog-loaded", len(catalog) > 0))

    app = ScreensaverApp(settings, autocalibrate=False)
    app.register(None)
    # Build the window here instead of going through activate(): the default
    # activate handler runs after any handler we could connect, so the window
    # would not exist yet when the assertions look for it.
    win = make_window(app, settings, autocalibrate=False)
    results.append(("window-built", win is not None))
    win.present()

    # Give the (compositor-less) display a moment to map the window.
    context = GLib.MainContext.default()
    deadline = time.monotonic() + 20.0
    while time.monotonic() < deadline and not win.get_mapped():
        if context.pending():
            context.iteration(False)
        else:
            time.sleep(0.01)
    results.append(("window-mapped", win.get_mapped()))

    rows = getattr(win, "_rows_by_id", {})
    results.append(("catalogue-rows-built", len(rows) == len(catalog)))

    # Tier badges come from the engine's list --json; with no launcher on PATH
    # they are absent, which is legal (the badge is then hidden).
    tiers = [r for r in getattr(win, "_by_id", {}).values() if r.get("tier")]
    results.append(("tier-badges-well-formed", len(tiers) <= len(catalog)))

    first = catalog[0] if catalog else {"id": "", "title": ""}
    schema = load_option_schema(first["id"])
    if not schema:
        print("SKIP options-dialog: no options schema for " + first["id"])
    else:
        dialog = OptionsDialog(win, settings, first, schema)
        results.append(("options-dialog-built", bool(dialog.get_title())))
        saved = settings.get_value("hack-options").unpack()
        try:
            dialog._on_randomize(None)
            picked = dialog._pending
            results.append(
                (
                    "options-randomize-in-range",
                    all(
                        _value_in_schema(r, picked.get(r["name"], r["default"]))
                        for r in schema
                    ),
                )
            )
            dialog._on_reset(None)
            results.append(
                (
                    "options-reset-to-default",
                    all(dialog._pending.get(r["name"]) == r["default"] for r in schema),
                )
            )
        finally:
            # The smoke test must never leave the settings it touched behind.
            settings.set_value(
                "hack-options",
                GLib.Variant("a{sa{ss}}", {k: dict(v) for k, v in saved.items()}),
            )
            dialog.destroy()

    failed = False
    for label, ok in results:
        print(f"{'PASS' if ok else 'FAIL'} {label}")
        failed = failed or not ok

    app.quit()
    return 1 if failed else 0


