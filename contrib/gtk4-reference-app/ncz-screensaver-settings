# Base class of the libadwaita window. Without Adw the class is still defined
# (its bodies only touch Adw at call time, and from __future__ import
# annotations keeps the annotations unevaluated) but never instantiated:
# make_window() picks GtkScreensaverWindow instead.
_AdwApplicationWindow = Adw.ApplicationWindow if _HAVE_ADW else Gtk.ApplicationWindow


class ScreensaverWindow(_AdwApplicationWindow):  # type: ignore[misc,valid-type]
    """The libadwaita "Screensaver & Lock" settings/chooser window (GNOME)."""

    def __init__(
        self,
        app: Adw.Application,
        settings: Gio.Settings,
        autocalibrate: bool = True,
    ) -> None:
        super().__init__(application=app)
        self._settings = settings
        self._status: dict | None = None
        self._gpus: list[dict] | None = None
        self._gpu_values: list[str] = ["auto", "off"]
        self._flagged_expander: Adw.ExpanderRow | None = None
        # Guard flag: skip writes triggered by our own GSettings callbacks so
        # external "changed" handlers do not produce feedback loops.
        self._suppress_changed = False

        self.set_title("Screensaver & Lock")
        self.set_default_size(720, 760)
        # Default to dark, mirroring the 57-screensaver look.
        self.add_css_class("night")

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()

        stop_btn = Gtk.Button.new_with_label("Stop preview")
        stop_btn.set_valign(Gtk.Align.CENTER)
        stop_btn.connect("clicked", lambda *_a: stop_preview())
        header.pack_end(stop_btn)

        self._search = Gtk.SearchEntry()
        self._search.set_placeholder_text("Search hacks…")
        self._search.set_valign(Gtk.Align.CENTER)
        self._search.set_hexpand(True)
        header.pack_start(self._search)

        toolbar.add_top_bar(header)

        page = Adw.PreferencesPage()
        toolbar.set_content(page)
        self._toasts = Adw.ToastOverlay()
        self._toasts.set_child(toolbar)
        self.set_content(self._toasts)

        self._build_screensaver_group(page)
        self._build_lock_group(page)
        self._build_color_group(page)
        self._build_gpu_group(page)
        self._build_verify_group(page)
        self._build_hack_groups(page)

        self._search.connect("search-changed", self._on_search_changed)
        self._connect_settings_signals()
        self._refresh_from_settings()
        if autocalibrate:
            self._maybe_autocalibrate()

    # ---- groups -----------------------------------------------------------

    def _build_screensaver_group(self, page: Adw.PreferencesPage) -> None:
        grp = Adw.PreferencesGroup.new()
        grp.set_title("Screensaver")
        page.add(grp)

        self._mode_row = Adw.ComboRow.new()
        self._mode_row.set_title("Mode")
        self._mode_nicks = mode_nicks()
        self._mode_model = Gtk.StringList.new([mode_label(n) for n in self._mode_nicks])
        self._mode_row.set_model(self._mode_model)
        self._mode_row.connect("notify::selected", self._on_mode_changed)
        grp.add(self._mode_row)

        self._idle_row = Adw.SpinRow.new_with_range(MINUTES_MIN, MINUTES_MAX, 1)
        self._idle_row.set_title("Start after (minutes)")
        self._idle_row.set_subtitle(
            "Minutes of inactivity before the screensaver starts"
        )
        self._idle_row.connect("changed", self._on_idle_changed)
        grp.add(self._idle_row)

        self._cycle_row = Adw.SpinRow.new_with_range(MINUTES_MIN, MINUTES_MAX, 1)
        self._cycle_row.set_title("Rotate every (minutes)")
        self._cycle_row.set_subtitle("Each hack runs this long in random / playlist")
        self._cycle_row.connect("changed", self._on_cycle_changed)
        grp.add(self._cycle_row)

        self._pool_row = Adw.ComboRow.new()
        self._pool_row.set_title("Screensavers used in random mode")
        self._pool_row.set_model(
            Gtk.StringList.new([pool_label(n) for n in pool_nicks()])
        )
        self._pool_row.connect("notify::selected", self._on_pool_class_changed)
        grp.add(self._pool_row)

    def _build_lock_group(self, page: Adw.PreferencesPage) -> None:
        grp = Adw.PreferencesGroup.new()
        grp.set_title("Lock and display")
        page.add(grp)

        self._lock_enabled_row = Adw.SwitchRow.new()
        self._lock_enabled_row.set_title("Lock after screensaver")
        self._lock_enabled_row.connect("notify::active", self._on_lock_enabled_changed)
        grp.add(self._lock_enabled_row)

