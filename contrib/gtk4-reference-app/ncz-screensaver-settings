def catalog_path() -> str | None:
    """Return the first existing TSV catalog file."""
    for c in CATALOG_CANDIDATES:
        if c and os.path.isfile(c):
            return c
    return None


def hack_dirs() -> list[str]:
    """Return the de-duplicated list of dirs to search for hack binaries."""
    env = HACK_DIR_CANDIDATES[0]
    raw = env.split(":") if env else HACK_DIR_CANDIDATES[1:]
    seen: set[str] = set()
    keep: list[str] = []
    for d in raw:
        if d and d not in seen and os.path.isdir(d):
            seen.add(d)
            keep.append(d)
    return keep


def load_catalog() -> list[dict]:
    """Parse the TSV catalog into list[{id,title,group}] dicts."""
    path = catalog_path()
    if not path:
        return []
    rows: list[dict] = []
    try:
        with open(path, encoding="utf-8") as f:
            for raw in f:
                line = raw.rstrip("\n")
                if not line or line.startswith("#"):
                    continue
                fields = line.split("\t")
                if len(fields) < 3:
                    continue
                rows.append({"id": fields[0], "title": fields[1], "group": fields[2]})
    except OSError:
        return []
    return rows


def load_broken() -> dict[str, tuple[str, str]]:
    """{hack id: (status, reason)} from broken.tsv; empty when not installed."""
    for path in (
        os.environ.get("NCZ_SCREENSAVER_BROKEN", ""),
        "/usr/share/ncz-screensavers/broken.tsv",
        "/usr/share/ncz-screensaver-chooser/broken.tsv",
    ):
        if path and os.path.isfile(path):
            out: dict[str, tuple[str, str]] = {}
            with open(path, encoding="utf-8") as f:
                for line in f:
                    fields = line.rstrip("\n").split("\t")
                    if (
                        len(fields) >= 3
                        and not line.startswith("#")
                        and fields[1] in ("broken", "suspect")
                    ):
                        out[fields[0]] = (fields[1], fields[2])
            return out
    return {}


def cli_cmd() -> list[str]:
    """Argv prefix of the launcher CLI; NCZ_SCREENSAVER_CLI overrides (tests)."""
    return [os.environ.get("NCZ_SCREENSAVER_CLI") or "ncz-screensaver"]


def cli_json(args: list[str]):
    """Run a launcher command that prints JSON; None on any failure."""
    try:
        proc = subprocess.run(
            cli_cmd() + args, capture_output=True, text=True, timeout=15, check=False
        )
        return json.loads(proc.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def normalize_pool(value: str) -> str:
    """Map legacy pool-gpu-class values (igpu-only) to the current nicks."""
    value = POOL_ALIASES.get(value, value)
    return value if value in pool_nicks() else "auto"


def short_renderer(name: str) -> str:
    """'Mesa Intel(R) UHD Graphics 630 (CFL GT2)' -> 'Mesa Intel UHD Graphics 630'."""
    name = name.replace("(R)", "").replace("(TM)", "")
    name = re.sub(r"\s*\([^)]*\)\s*$", "", name)
    return re.sub(r"\s+", " ", name).strip()


def class_summary(status: dict | None, gpus: list[dict] | None) -> str:
    """Text for the 'Graphics chips' row from status/gpus JSON.

    Per-GPU verdict (UX requirement, operator 2026-09-30): the panel GPU is
    GPU0 and any offload candidates are GPU1..N. The plain class name from
    the cache (`status.gpu_class`) is only used as a fallback when the
    launcher did not include the per-GPU verdict (older builds).
    """
    if not status:
        return "Not measured yet"
    rows = status.get("gpu_verdict_rows") if isinstance(status, dict) else None
    if isinstance(rows, list) and rows:
        parts = []
        for r in rows:
            cls = r.get("class") if isinstance(r, dict) else None
            label = CLASS_TITLE.get(cls, (cls or "Unknown").title())
            ms = r.get("ms") if isinstance(r, dict) else None
            extra = ""
            if isinstance(ms, (int, float)) and ms:
                extra = f" ({ms:.1f} ms on the calibration test)"
            elif isinstance(r, dict) and r.get("renderer"):
                extra = f" (estimated from {short_renderer(r['renderer'])})"
            parts.append(f"{r.get('index', 'GPU?')} ({label}){extra}")
        return ", ".join(parts)
    cls = status.get("gpu_class") if isinstance(status, dict) else None
    if not cls:
        return "Not measured yet"
    parts = []
    ms = status.get("gpu_class_score_ms")
    if ms and status.get("gpu_class_source") == "calibration":
        parts.append(f"{ms:.1f} ms on the calibration test")
    else:
        parts.append("estimated from the chip name")
    # Pick the panel GPU explicitly (display=True) rather than gpus[0] so the
    # renderer string matches what the per-GPU verdict path uses. Mirrors
    # `gpus --json`'s `display` flag ordering.
    disp = next((g for g in gpus or [] if g.get("display")), None)
    if disp and disp.get("renderer"):
        parts.append(short_renderer(disp["renderer"]))
    return f"{CLASS_TITLE.get(cls, cls.title())} ({'; '.join(parts)})"


def prime_offload_text(status: dict | None) -> str:
    """Plain-English description of the PRIME offload policy, or ''.

    Surfaces the explanation the launcher embeds in `status.prime_offload`.
    Empty when the field is absent or the launcher is older than 0.7.11.
    A current launcher explains unsupported single-GPU layouts. It never implies a software
    rendering fallback on a GPU system.
    """
    if not isinstance(status, dict):
        return ""
    return str(status.get("prime_offload") or "").strip()


def gpu_choices(gpus: list[dict] | None, stored: str) -> list[tuple[str, str]]:
    """(value, label) rows for the Screensaver GPU combo."""
    out = [("auto", "Automatic"), ("off", "Off (use the display GPU)")]
    for g in gpus or []:
        if g.get("display"):
            continue
        vendor = VENDOR_LABEL.get(g.get("vendor", ""), str(g.get("vendor", "")).title())
        cls = CLASS_TITLE.get(g.get("class", ""), g.get("class", "unknown"))
        out.append(
            (g["id"], f"{vendor} {g.get('driver', '')} ({cls})".replace("  ", " "))
        )
    if stored == "prime":
        out.append(("prime", "Always the best other GPU (legacy)"))
    elif stored not in dict(out):
        out.append((stored, f"{stored} (not found)"))
    return out


def load_overlay() -> dict[str, dict]:
    """{hack id: row} from `ncz-screensaver list --json`; empty if unavailable."""
    rows = cli_json(["list", "--json"])
    if not isinstance(rows, list):
        return {}
    return {r["id"]: r for r in rows if isinstance(r, dict) and "id" in r}


def compute_groups(
    catalog: list[dict],
    overlay: dict[str, dict],
    installed: dict[str, bool],
    known: dict[str, tuple[str, str]],
    show_all: bool,
) -> list[dict]:
    """Group model shared by the window and --dump.

    Each group: {title, collapsed, expander, rows}; each row: id, title, group,
    flagged, badge, subtitle, tooltip, issue, issue_reason, installed, tier,
    tier_label. `tier` is the minimum GPU class the engine reports for the
    screensaver ("weak", "mid" or "strong"); it is "" until tiers.tsv has been
    measured, in which case no badge is shown.
    """
    rows = []
    for r in catalog:
        ov = overlay.get(r["id"], {})
        flagged = bool(ov.get("flagged"))
        issue = ov.get("issue") or (known[r["id"]][0] if r["id"] in known else "")
        reason = ov.get("issue_reason") or (
            known[r["id"]][1] if r["id"] in known else ""
        )
        ok = installed.get(r["id"], False)
        expect = ov.get("expect") or ""
        # `list --json` reports min_class from tiers.tsv; "unknown" while the
        # saver has not been benchmarked, and the key is absent on older
        # launchers. Both mean "no badge".
        tier = ov.get("min_class") or ""
        if tier not in TIER_RANK:
            tier = ""
        if not ok:
            sub = "not installed"
        elif flagged:
            sub = expect or "may stutter on this graphics chip"
        else:
            sub = r["group"]
        rows.append(
            {
                "id": r["id"],
                "title": r["title"],
                "group": r["group"],
                "flagged": flagged,
                "badge": FLAG_BADGE if flagged else "",
                "subtitle": sub,
                "tooltip": FLAG_TOOLTIP if flagged else "",
                "expect": expect,
                "issue": issue,
                "issue_reason": reason,
                "installed": ok,
                "tier": tier,
                "tier_label": TIER_BADGE_TEXT.get(tier, ""),
                "tier_tooltip": TIER_BADGE_TOOLTIP.get(tier, ""),
            }
        )
    if not any(r["flagged"] for r in rows):
        groups: dict[str, list[dict]] = {}
        for r in rows:
            r["subtitle"] = r["subtitle"] if not r["installed"] else r["id"]
            groups.setdefault(r["group"], []).append(r)
        return [
            {"title": g, "collapsed": False, "expander": False, "rows": v}
            for g, v in groups.items()
        ]
    order = {g: i for i, g in enumerate(dict.fromkeys(r["group"] for r in rows))}

    def key(r: dict):
        return (order[r["group"]], r["title"].lower())

    good = sorted((r for r in rows if not r["flagged"]), key=key)
    bad = sorted((r for r in rows if r["flagged"]), key=key)
    out = []
    if good:
        out.append(
            {"title": GOOD_TITLE, "collapsed": False, "expander": False, "rows": good}
        )
    out.append(
        {
            "title": FLAGGED_TITLE,
            "collapsed": not show_all,
            "expander": True,
            "rows": bad,
        }
    )
    return out


def flag_warning(row: dict) -> str:
    """Body text of the confirmation shown before running a flagged hack."""
    note = f" ({row['expect']})" if row.get("expect") else ""
    return f"This screensaver may stutter on this graphics chip{note}. Run it anyway?"


def load_option_schema(hack_id: str) -> list[dict]:
    """Rows of options/<hack>.tsv (same format the launcher reads)."""
    base = os.environ.get(
        "NCZ_SCREENSAVER_OPTIONS", "/usr/share/ncz-screensavers/options"
    )
    short = hack_id.removesuffix("_gles3")
    for stem in (hack_id, short):
        path = os.path.join(base, f"{stem}.tsv")
        if not os.path.isfile(path):
            continue
        rows = []
        with open(path, encoding="utf-8") as f:
            for line in f:
                c = (line.rstrip("\n").split("\t") + [""] * 10)[:10]
                if (
                    not line.strip()
                    or line.startswith("#")
                    or c[1] not in ("bool", "int", "float", "enum", "string")
                ):
                    continue
                rows.append(
                    {
                        "name": c[0],
                        "type": c[1],
                        "default": c[2],
                        "min": c[3],
                        "max": c[4],
                        "choices": [x for x in c[5].split(",") if x],
                        "label": c[6] or c[0],
                        "description": c[7],
                        "group": c[8] or "General",
                    }
                )
        return rows
    return []


def randomize_options(
    schema: list[dict], current: dict[str, str], *, rng: random.Random | None = None
) -> dict[str, str]:
    """One fresh random value per option, inside the range the schema allows.

    This is the reference app's "randomize everything": one call fills the whole
    per-screensaver option set the way the engine's own option files describe
    it - numeric options stay inside [min, max], enums pick one of the declared
    choices, booleans flip and free-form strings keep the value the user typed
    (there is nothing sensible to randomise for those).
    """
    rng = rng or random.SystemRandom()
    out: dict[str, str] = {}
    for row in schema:
        name, kind = row["name"], row["type"]
        if kind == "bool":
            base = (current.get(name) or row["default"] or "false").lower() == "true"
            out[name] = "true" if (rng.random() < 0.5) ^ base else "false"
        elif kind == "enum":
            choices = row["choices"] or [row["default"]]
            out[name] = rng.choice(choices) if choices else row["default"]
        elif kind in ("int", "float"):
            try:
                lo, hi = float(row["min"] or 0), float(row["max"] or 100)
            except ValueError:
                lo, hi = 0.0, 100.0
            hi = max(hi, lo)
            out[name] = (
                f"{rng.uniform(lo, hi):.2f}"
                if kind == "float"
                else str(rng.randint(int(lo), int(hi)))
            )
        else:
            out[name] = current.get(name, row["default"])
    return out


def preview_argv(hack_id: str, options: dict[str, str]) -> list[str]:
    """Argv for a 30 s preview of one screensaver with the given options.

    Every engine call in this app goes through cli_cmd(), so a distribution that
    installs the launcher under another name or path (NCZ_SCREENSAVER_CLI) is
    honoured. The options travel as the CLI's --option flags rather than
    through GSettings so the preview shows the staged, not the saved, values.
    """
    cmd = cli_cmd() + ["preview", hack_id, "--seconds", "30"]
    for key, value in options.items():
        cmd += ["--option", f"{key}={value}"]
    return cmd


def make_option_row(row: dict, value: str, on_change) -> tuple[Gtk.Widget, callable]:
    """Build one option row and return (widget, set_value).

    `set_value(text)` pushes a value into the widget without touching
    `on_change`; the caller uses it for Reset and Randomize so both work the
    same way on every widget backend. libadwaita rows are used when Adw is
    available; otherwise the same row is built from plain GTK4 widgets, which
    is what keeps the dialog usable on a session without libadwaita.
    """
    kind, name = row["type"], row["name"]
    if kind == "bool":
        if _HAVE_ADW:
            w = Adw.SwitchRow.new()
            w.set_active(value == "true")
            w.connect(
                "notify::active",
                lambda r, _p: on_change(name, "true" if r.get_active() else "false"),
            )
            set_value = lambda v: w.set_active(v == "true")
        else:
            w = _gtk_row_shell(row)
            sw = Gtk.Switch(halign=Gtk.Align.START)
            sw.set_active(value == "true")
            sw.connect(
                "notify::active",
                lambda r, _p: on_change(name, "true" if r.get_active() else "false"),
            )
            w.append(sw)
            set_value = lambda v: sw.set_active(v == "true")
    elif kind == "enum":
        choices = row["choices"] or [row["default"]]
        if _HAVE_ADW:
            w = Adw.ComboRow.new()
            w.set_model(Gtk.StringList.new(choices))
            w.set_selected(choices.index(value) if value in choices else 0)
            w.connect(
                "notify::selected",
                lambda r, _p: on_change(
                    name, choices[min(r.get_selected(), len(choices) - 1)]
                ),
            )
            set_value = lambda v: w.set_selected(
                choices.index(v) if v in choices else 0
            )
        else:
            w = _gtk_row_shell(row)
            drop = Gtk.DropDown.new_from_strings(choices)
            drop.set_selected(choices.index(value) if value in choices else 0)
            drop.connect(
                "notify::selected",
                lambda r, _p: on_change(
                    name, choices[min(r.get_selected(), len(choices) - 1)]
                ),
            )
            w.append(drop)
            set_value = lambda v: drop.set_selected(
                choices.index(v) if v in choices else 0
            )
    elif kind in ("int", "float"):
        is_float = kind == "float"
        try:
            lo, hi = float(row["min"] or 0), float(row["max"] or 100)
        except ValueError:
            lo, hi = 0.0, 100.0
        hi = max(hi, lo)
        step = (0.05 if hi - lo <= 10 else 0.5) if is_float else 1
        try:
            cur = float(value)
        except ValueError:
            cur = lo
        adj = Gtk.Adjustment(
            value=min(max(cur, lo), hi),
            lower=lo,
            upper=hi,
            step_increment=step,
            page_increment=step * 10,
        )

        def emit(n: float) -> str:
            return f"{n:.2f}" if is_float else str(int(n))

        if _HAVE_ADW:
            w = Adw.SpinRow(adjustment=adj, digits=2 if is_float else 0)
            w.connect(
                "notify::value", lambda r, _p: on_change(name, emit(r.get_value()))
            )
            set_value = lambda v: w.set_value(min(max(float(v or 0), lo), hi))
        else:
            w = _gtk_row_shell(row)
            spin = Gtk.SpinButton(adjustment=adj, digits=2 if is_float else 0)
            spin.connect(
                "value-changed", lambda r: on_change(name, emit(r.get_value()))
            )
            w.append(spin)
            set_value = lambda v: spin.set_value(min(max(float(v or 0), lo), hi))
    else:
        if _HAVE_ADW:
            w = Adw.EntryRow.new()
            w.set_text(value)
            w.connect("changed", lambda r: on_change(name, r.get_text()))
            set_value = lambda v: w.set_text(v)
        else:
            w = _gtk_row_shell(row)
            entry = Gtk.Entry()
            entry.set_text(value)
            entry.connect("changed", lambda r: on_change(name, r.get_text()))
            w.append(entry)
            set_value = lambda v: entry.set_text(v)
    if _HAVE_ADW:
        w.set_title(row["label"] or name)
        # Only Adw.SwitchRow/ComboRow/SpinRow take a subtitle; Adw.EntryRow has
        # no such setter in any libadwaita release, so fall back to a tooltip
        # rather than dropping the help text.
        if row["description"]:
            if hasattr(w, "set_subtitle"):
                w.set_subtitle(row["description"])
            else:
                w.set_tooltip_text(row["description"])
    return w, set_value


def _gtk_row_shell(row: dict) -> Gtk.Box:
    """Label + description box used by the plain-GTK4 option rows."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    label = Gtk.Label(label=row["label"] or row["name"])
    label.set_xalign(0.0)
    box.append(label)
    if row["description"]:
        sub = Gtk.Label(label=row["description"])
        sub.set_xalign(0.0)
        sub.set_wrap(True)
        sub.add_css_class("dim-label")
        box.append(sub)
    return box


class OptionsDialog(Adw.Window if _HAVE_ADW else Gtk.Window):
    """Editor for one screensaver's options: randomize, preview, reset, apply.

    The dialog is a modal window on libadwaita and on plain GTK4 alike; only
    the widgets inside differ. Values are staged in `_pending` and written to
    the `hack-options` schema key on Apply, so Cancel-like closes and a crash
    never leave half a screensaver configured.
    """

    def __init__(
        self, parent: Gtk.Window, settings: Gio.Settings, hack: dict, schema: list[dict]
    ):
        super().__init__(
            transient_for=parent, modal=True, title=f"{hack['title']} options"
        )
        self.set_default_size(520, 640)
        self._settings = settings
        self._hack_id = hack["id"]
        self._schema = schema
        stored = settings.get_value("hack-options").unpack()
        self._pending: dict[str, str] = dict(stored.get(self._hack_id, {}))
        self._widgets: dict[str, Gtk.Widget] = {}
        self._setters: dict[str, object] = {}
        # Set while Reset/Randomize push values into the widgets: their
        # notify:: signals would otherwise feed the widget's own formatting
        # (0.50, 1.0) straight back into the staged values and undo the reset.
        self._updating = False

        def on_change(name: str, value: str) -> None:
            if not self._updating:
                self._pending[name] = value

        def button(label: str, tooltip: str, handler) -> Gtk.Button:
            b = Gtk.Button.new_with_label(label)
            b.set_tooltip_text(tooltip)
            b.connect("clicked", handler)
            return b

        reset = button(
            "Reset to defaults",
            "Put every option of this screensaver back to its default",
            self._on_reset,
        )
        randomize = button(
            "Randomize all",
            "Pick a new random value inside the allowed range for every option",
            self._on_randomize,
        )
        preview = button(
            "Preview", "Run this screensaver with the staged options", self._on_preview
        )
        apply_btn = button(
            "Apply", "Save these options for this screensaver", self._on_apply
        )
        apply_btn.add_css_class("suggested-action")

        groups: dict[str, list[Gtk.Widget]] = {}
        for row in schema:
            widget, setter = make_option_row(row, self._value(row), on_change)
            self._widgets[row["name"]] = widget
            self._setters[row["name"]] = setter
            groups.setdefault(row["group"] or "General", []).append(widget)

        if _HAVE_ADW:
            toolbar = Adw.ToolbarView()
            header = Adw.HeaderBar()
            toolbar.add_top_bar(header)
            page = Adw.PreferencesPage()
            made: dict[str, Adw.PreferencesGroup] = {}
            for title, widgets in groups.items():
                grp = made.get(title)
                if grp is None:
                    grp = Adw.PreferencesGroup.new()
                    grp.set_title(title)
                    page.add(grp)
                    made[title] = grp
                for widget in widgets:
                    grp.add(widget)
            toolbar.set_content(page)
            self.set_content(toolbar)
            header.pack_start(reset)
            header.pack_start(randomize)
            header.pack_end(preview)
            header.pack_end(apply_btn)
        else:
            toolbar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            header = Gtk.HeaderBar()
            header.pack_start(reset)
            header.pack_start(randomize)
            header.pack_end(preview)
            header.pack_end(apply_btn)
            toolbar.append(header)
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
            page.set_margin_top(12)
            page.set_margin_bottom(12)
            page.set_margin_start(12)
            page.set_margin_end(12)
            for title, widgets in groups.items():
                group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                caption = Gtk.Label(label=title)
                caption.set_xalign(0.0)
                caption.add_css_class("heading")
                group.append(caption)
                for widget in widgets:
                    group.append(widget)
                page.append(group)
            scroll = Gtk.ScrolledWindow(vexpand=True)
            scroll.set_child(page)
            toolbar.append(scroll)
            self.set_child(toolbar)  # Gtk.Window; Adw.Window uses set_content()

    def _value(self, row: dict) -> str:
        return self._pending.get(row["name"], row["default"])

    def _apply_values(self, values: dict[str, str]) -> None:
        """Push values into the widgets without re-entering on_change."""
        self._updating = True
        try:
            for name, setter in self._setters.items():
                setter(values.get(name, ""))
        finally:
            self._updating = False

    def _on_reset(self, _btn: Gtk.Button) -> None:
        self._pending = {row["name"]: row["default"] for row in self._schema}
        self._apply_values(self._pending)

    def _on_randomize(self, _btn: Gtk.Button) -> None:
        self._pending = randomize_options(self._schema, self._pending)
        self._apply_values(self._pending)

    def _on_apply(self, _btn: Gtk.Button) -> None:
        stored = self._settings.get_value("hack-options").unpack()
        stored = {k: dict(v) for k, v in stored.items()}
        stored[self._hack_id] = {
            row["name"]: self._pending.get(row["name"], row["default"])
            for row in self._schema
        }
        self._settings.set_value("hack-options", GLib.Variant("a{sa{ss}}", stored))
        self.close()

    def _on_preview(self, _btn: Gtk.Button) -> None:
        """Preview through $NCZ_SCREENSAVER_CLI, like every other CLI call."""
        try:
            Gio.Subprocess.new(
                preview_argv(self._hack_id, self._pending),
                Gio.SubprocessFlags.NONE,
            )
        except GLib.Error as e:
            sys.stderr.write(f"preview {self._hack_id}: {e}\n")


def is_installed(hack_id: str, dirs: list[str]) -> bool:
    """Return True when an executable named hack_id exists in any search dir."""
    return any(os.path.isfile(os.path.join(d, hack_id)) for d in dirs)


def build_catalog_view(catalog: list[dict], dirs: list[str]) -> list[dict]:
    """Combine the catalog with installation status; used by --dump."""
    return [{**row, "installed": is_installed(row["id"], dirs)} for row in catalog]


