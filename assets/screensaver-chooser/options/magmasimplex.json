    {
      "id": "material",
      "type": "enum",
      "label": "Wax material",
      "default": "auto",
      "choices": [
        "auto",
        "milky",
        "translucent",
        "jelly"
      ],
      "group": "Look",
      "description": "milky: opaque, matte, pitted wax like real lamps. translucent: lit through. jelly: the earlier glossy candy look; opt-in, never drawn.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_MATERIAL"
    },
    {
      "id": "texture",
      "type": "float",
      "label": "Wax texture",
      "default": 1.0,
      "range": [
        0.0,
        2.0
      ],
      "group": "Look",
      "description": "Strength of the pits, marbling, striations and cooled skin; 0 = smooth.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_TEXTURE"
    },
    {
      "id": "glitter",
      "type": "enum",
      "label": "Glitter",
      "default": "auto",
      "choices": [
        "auto",
        "none",
        "silver",
        "gold",
        "rainbow"
      ],
      "group": "Look",
      "description": "Metal flecks suspended in the liquid; auto follows the palette (the glitter lamps).",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_GLITTER"
    },
    {
      "id": "glitter-amount",
      "type": "float",
      "label": "Glitter amount",
      "default": 1.0,
      "range": [
        0.0,
        2.0
      ],
      "group": "Look",
      "description": "How many flecks.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_GLITTER_AMOUNT"
    },
    {
      "id": "motes",
      "type": "float",
      "label": "Motes and bubbles",
      "default": 1.0,
      "range": [
        0.0,
        2.0
      ],
      "group": "Look",
      "description": "Density of drifting specks and micro-bubbles.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_MOTES"
    },
    {
      "id": "glass",
      "type": "float",
      "label": "Glass",
      "default": 1.0,
      "range": [
        0.0,
        2.0
      ],
      "group": "Look",
      "description": "Strength of reflections, dust and smudges on the glass.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_GLASS"
    },
    {
      "id": "depth",
      "type": "float",
      "label": "Immersion depth",
      "default": 1.0,
      "range": [
        0.3,
        2.0
      ],
      "group": "Camera",
      "description": "How far apart the depth layers sit and how much the liquid fogs the far wax.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_DEPTH"
    },
    {
      "id": "drift",
      "type": "float",
      "label": "Camera drift",
      "default": 1.0,
      "range": [
        0.0,
        2.0
      ],
      "group": "Camera",
      "description": "How far the camera wanders; 0 = still.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_DRIFT"
    },
    {
      "id": "kaleidoscope",
      "type": "int",
      "label": "Kaleidoscope",
      "default": -1,
      "range": [
        -1,
        12
      ],
      "group": "Camera",
      "description": "Light show mirror sectors: 0 or 1 off, 2 to 12 sectors; -1 draws one.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_KALEIDOSCOPE"
    },
    {
      "id": "chapter",
      "type": "float",
      "label": "Chapter length",
      "default": 1.0,
      "range": [
        0.1,
        5.0
      ],
      "group": "Camera",
      "description": "Scales how long each view lasts before cross-fading to the next (views 6-10 min, light show 2-4 min at 1).",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_CHAPTER"
    },
    {
      "id": "speed",
      "type": "float",
      "label": "Speed",
      "default": 1.0,
      "range": [
        0.1,
        8.0
      ],
      "group": "Physics",
      "description": "1 = the pace of a real lamp (calibrated on real-time footage); higher compresses time.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_SPEED"
    },
    {
      "id": "viscosity",
      "type": "float",
      "label": "Viscosity",
      "default": 1.0,
      "range": [
        0.5,
        2.0
      ],
      "group": "Physics",
      "description": "How thick the liquid is: higher is slower and heavier.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_VISCOSITY"
    },
    {
      "id": "heat",
      "type": "float",
      "label": "Heat",
      "default": 1.0,
      "range": [
        0.5,
        1.5
      ],
      "group": "Physics",
      "description": "How hard the bulb heats the wax: higher lifts more often.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_HEAT"
    },
    {
      "id": "wax",
      "type": "float",
      "label": "Wax amount",
      "default": 1.0,
      "range": [
        0.6,
        1.4
      ],
      "group": "Physics",
      "description": "How much wax is in play in the column.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_WAX"
    },
    {
      "id": "cap",
      "type": "enum",
      "label": "Top mass",
      "default": "auto",
      "choices": [
        "auto",
        "on",
        "off"
      ],
      "group": "Physics",
      "description": "Cooled wax collects under the top and drips stalactites.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_CAP"
    },
    {
      "id": "startup",
      "type": "bool",
      "label": "Warm up from cold",
      "default": false,
      "group": "Physics",
      "description": "Start as a lamp just switched on: a cold slab that softens, a first column, then the cap.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_STARTUP"
    },
    {
      "id": "projector-mask",
      "type": "enum",
      "label": "Projector mask",
      "default": "soft",
      "choices": [
        "off",
        "soft",
        "dish",
        "disc"
      ],
      "group": "Camera",
      "description": "Light shows (show, Flowerchild). off: the picture fills the whole screen. soft: the projector's round throw with a dark surround. dish: a bright dish on black, pulsing. disc: a larger, brighter, cooler dish (both Flowerchild only). The dish and disc default to a large size that fills most of the screen.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_PROJECTOR_MASK"
    },
    {
      "id": "projector-mask-size",
      "type": "float",
      "label": "Projector mask size",
      "default": 0.0,
      "range": [
        0.0,
        1.0
      ],
      "group": "Camera",
      "description": "Light shows (dish/disc). 0 = the style's default (about 0.92 of the short side, a large lit disc). Otherwise the radius as a fraction of the short side, 0.30 to 1.00; values between 0.01 and 0.30 are clamped up so the lit area never breaks at the screen edge.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_PROJECTOR_MASK_SIZE"
    },
    {
      "id": "dendrites",
      "type": "enum",
      "label": "Dendrites",
      "default": "off",
      "choices": [
        "off",
        "ink",
        "veins"
      ],
      "group": "Look",
      "description": "Flowerchild only. off: the dye field unchanged (default). ink: a dark branching ink tree with red droplets over the bright dish. veins: a fibrous vein network where two dyes interdigitate. Never drawn: scenes set it.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_DENDRITES"
    },
    {
      "id": "dendrite-strength",
      "type": "float",
      "label": "Dendrite strength",
      "default": 1.0,
      "range": [
        0.0,
        1.0
      ],
      "group": "Look",
      "description": "Flowerchild only: how strongly the ink tree or the vein network is drawn, 0 to 1.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_DENDRITE_STRENGTH"
    },
    {
      "id": "poster",
      "type": "bool",
      "label": "Poster art",
      "default": false,
      "group": "Look",
      "description": "Flowerchild only: flat colour bands with hard edges and no glow, like a printed poster.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_POSTER"
    },
    {
      "id": "overlay",
      "type": "enum",
      "label": "Projector layers",
      "default": "off",
      "choices": [
        "off",
        "streaks",
        "neon",
        "both"
      ],
      "group": "Look",
      "description": "Flowerchild only: extra projectors over the dye. streaks: tall drifting colour streaks. neon: neon-sign tubes. both.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_OVERLAY"
    },
    {
      "id": "dynamics",
      "type": "float",
      "label": "Dynamics",
      "default": 0.0,
      "range": [
        0.0,
        1.0
      ],
      "group": "Dynamics",
      "description": "How strongly the beat drives every magmasimplex view. 0 = the pre-beat look exactly (default); the Fillmore live presets raise it.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_DYNAMICS"
    },
    {
      "id": "tempo",
      "type": "int",
      "label": "Tempo",
      "default": 0,
      "range": [
        0,
        180
      ],
      "group": "Dynamics",
      "description": "0 = auto: the virtual beat draws 96..132 BPM and drifts slowly. 60..180 fixes the tempo (used when no audio is driving).",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_TEMPO"
    },
    {
      "id": "audio",
      "type": "enum",
      "label": "Audio sync",
      "default": "off",
      "choices": [
        "off",
        "system",
        "mic"
      ],
      "group": "Dynamics",
      "description": "off: a procedural virtual beat, no audio (default). system: listen to the default output monitor (what is playing). mic: listen to the default microphone ONLY when explicitly selected; a log line is printed every time capture starts. Falls back to the virtual beat quietly if capture fails.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_AUDIO"
    },
    {
      "id": "colourway",
      "type": "int",
      "label": "Colourway",
      "default": -1,
      "range": [
        -1,
        29
      ],
      "group": "Look",
      "description": "fluid engine. Liquid and wax colour pairing, 0 to 29; -1 picks one per run.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_COLOURWAY"
    },
    {
      "id": "quality",
      "type": "enum",
      "label": "Quality",
      "default": "auto",
      "choices": [
        "auto",
        "low",
        "high",
        "ultra"
      ],
      "group": "System",
      "description": "auto: light on weak GPUs, full elsewhere. low: light. high and ultra: full (ultra also raises the fluid grid).",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_QUALITY"
    },
    {
      "id": "seed",
      "type": "int",
      "label": "Random seed",
      "default": 0,
      "range": [
        0,
        4294970000
      ],
      "group": "System",
      "description": "Fixes the per-launch randomness so a run can be reproduced; 0 = random.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_SEED"
    },
    {
      "id": "pattern-seed",
      "type": "enum",
      "label": "Pattern seed",
      "default": "auto",
      "choices": [
        "auto",
        "fixed"
      ],
      "group": "System",
      "description": "What draws the pattern geometry. auto: the run or slice seed (the driver's per-slice seed) wins, and a seed that only a scene set is ignored; fixed: a scene that sets seed keeps it as the pattern seed, to reproduce one exact layout.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_PATTERN_SEED"
    }
  ]
}
