{
  "options": [
    {
      "id": "engine",
      "type": "enum",
      "label": "Engine",
      "default": "goo",
      "choices": [
        "goo",
        "fluid"
      ],
      "group": "Look",
      "description": "goo: molten wax bodies with translucent optics (default). fluid: the older grid fluid simulation.",
      "level": "advanced",
      "env": "NCZ_MAGMASIMPLEX_ENGINE"
    },
    {
      "id": "preset",
      "type": "string",
      "label": "Scene",
      "default": "",
      "group": "Scene",
      "description": "Named bundle of options (see --list-presets): applied above the saved config file and below environment and command line. Empty = none.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_PRESET"
    },
    {
      "id": "randomize",
      "type": "enum",
      "label": "Randomize",
      "default": "auto",
      "choices": [
        "auto",
        "off"
      ],
      "group": "Scene",
      "description": "auto: every setting you leave unset is drawn from the seed, so each launch is a different, reproducible lamp. off: unset settings take their defaults.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_RANDOMIZE"
    },
    {
      "id": "view",
      "type": "enum",
      "label": "View",
      "default": "auto",
      "choices": [
        "auto",
        "inside",
        "glass",
        "show",
        "field",
        "butterfly"
      ],
      "group": "Scene",
      "description": "auto: slow chapters that cross-fade between the others. inside: suspended in the liquid among the wax. glass: eye against the glass. show: a 1960s liquid light show. field: the classic full-screen lamp (lightest). butterfly: Flowerchild, an overhead-projector dye show, saturated and slowly pulsing.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_VIEW"
    },
    {
      "id": "world",
      "type": "enum",
      "label": "World",
      "default": "auto",
      "choices": [
        "auto",
        "tank",
        "dish",
        "radial",
        "drift"
      ],
      "group": "Scene",
      "description": "Where the heat comes from: tank (below), dish (one side), radial (a hot centre), drift (gravity swings slowly).",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_WORLD"
    },
    {
      "id": "palette-era",
      "type": "enum",
      "label": "Palette era",
      "default": "auto",
      "choices": [
        "auto",
        "1960s",
        "1970s",
        "1980s",
        "1990s",
        "modern"
      ],
      "group": "Look",
      "description": "Narrows the palettes drawn when palette=auto: the lamps of a decade, or modern.",
      "level": "basic",
      "env": "NCZ_MAGMASIMPLEX_PALETTE_ERA"
    },
