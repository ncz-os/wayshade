    {
      "id": "palette-cycle",
      "type": "float",
      "label": "Palette cycle (min)",
      "default": 0.0,
      "range": [
        0.0,
        60.0
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Minutes between slow cross-fades to another palette of the same family (interpolated in Oklab: lightness moves steadily from one palette to the other, never through grey). 0 = keep one palette.",
      "env": "NCZ_XSHADERTOY_CHITIN_PALETTE_CYCLE"
    },
    {
      "id": "speed",
      "type": "float",
      "label": "Speed",
      "default": 1.0,
      "range": [
        0.25,
        3.0
      ],
      "group": "Motion",
      "level": "basic",
      "description": "Time scale of every motion.",
      "env": "NCZ_XSHADERTOY_CHITIN_SPEED"
    },
    {
      "id": "evolution",
      "type": "float",
      "label": "Evolution",
      "default": 1.0,
      "range": [
        0.0,
        3.0
      ],
      "group": "Motion",
      "level": "advanced",
      "description": "Pace of the slow director: seeded keyframes about every minute that change structure over minutes. 0 holds the opening structure.",
      "env": "NCZ_XSHADERTOY_CHITIN_EVOLUTION"
    },
    {
      "id": "form",
      "type": "enum",
      "label": "Form",
      "default": "nave",
      "choices": [
        "nave",
        "conduit",
        "lathe",
        "comb",
        "sump"
      ],
      "group": "Look",
      "level": "advanced",
      "description": "How the ribs, conduits and pores are arranged: nave (arched vault), conduit (bundled runs on chevron ribs), lathe (concentric turned ribs with radial runs), comb (spines with tooth rows), sump (chevrons converging on a trench).",
      "env": "NCZ_XSHADERTOY_CHITIN_FORM"
    },
    {
      "id": "relief",
      "type": "float",
      "label": "Relief",
      "default": 1.0,
      "range": [
        0.5,
        1.6
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Height of the relief as seen in the raking light.",
      "env": "NCZ_XSHADERTOY_CHITIN_RELIEF"
    },
    {
      "id": "warp",
      "type": "float",
      "label": "Warp",
      "default": 0.5,
      "range": [
        0.0,
        1.0
      ],
      "group": "Simulation",
      "level": "advanced",
      "description": "How far the structure is bent out of true by the three-octave domain warp. 0 is ruled and rigid.",
      "env": "NCZ_XSHADERTOY_CHITIN_WARP"
    },
    {
      "id": "asymmetry",
      "type": "float",
      "label": "Asymmetry",
      "default": 0.1,
      "range": [
        0.05,
        0.15
      ],
      "group": "Simulation",
      "level": "advanced",
      "description": "How far the two halves differ. The picture is mirrored, then broken by this much.",
      "env": "NCZ_XSHADERTOY_CHITIN_ASYMMETRY"
    },
    {
      "id": "conduits",
      "type": "float",
      "label": "Conduits",
      "default": 0.65,
      "range": [
        0.2,
        1.0
      ],
      "group": "Simulation",
      "level": "advanced",
      "description": "Share of conduit runs that are present.",
      "env": "NCZ_XSHADERTOY_CHITIN_CONDUITS"
    },
    {
      "id": "pores",
      "type": "float",
      "label": "Pores",
      "default": 0.6,
      "range": [
        0.0,
        1.0
      ],
      "group": "Simulation",
      "level": "advanced",
      "description": "Share of the pore lattice that is pitted.",
      "env": "NCZ_XSHADERTOY_CHITIN_PORES"
    },
    {
      "id": "sheen",
      "type": "float",
      "label": "Sheen",
      "default": 0.5,
      "range": [
        0.0,
        1.0
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Material, from dry bone (0) to polished gunmetal (1).",
      "env": "NCZ_XSHADERTOY_CHITIN_SHEEN"
    },
    {
      "id": "accent",
      "type": "float",
      "label": "Accent",
      "default": 0.05,
      "range": [
        0.0,
        0.08
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Share of conduit runs painted in the muted second tone. Never more than 8 percent.",
      "env": "NCZ_XSHADERTOY_CHITIN_ACCENT"
    },
    {
      "id": "light",
      "type": "float",
      "label": "Light direction",
      "default": 0.5,
      "range": [
        0.0,
        1.0
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Where the raking light comes from: 0.5 is straight above, the ends are from either side.",
      "env": "NCZ_XSHADERTOY_CHITIN_LIGHT"
    },
    {
      "id": "light-drift",
      "type": "float",
      "label": "Light drift",
      "default": 0.35,
      "range": [
        0.0,
        1.0
      ],
      "group": "Motion",
      "level": "advanced",
      "description": "How far the light slowly swings back and forth. 0 holds it still.",
      "env": "NCZ_XSHADERTOY_CHITIN_LIGHT_DRIFT"
    },
    {
      "id": "scroll",
      "type": "float",
      "label": "Scroll",
      "default": 0.4,
      "range": [
        0.0,
        1.0
      ],
      "group": "Motion",
      "level": "advanced",
      "description": "Speed of the slow travel along the structure (lathe: the surface turns slowly around the column).",
      "env": "NCZ_XSHADERTOY_CHITIN_SCROLL"
    },
    {
      "id": "randomize",
      "type": "bool",
      "label": "Randomize",
      "default": true,
      "group": "System",
      "level": "advanced",
      "description": "Draw every option you have not set (and the palette) from the run seed, inside ranges chosen to stay coherent. Off: defaults.",
      "env": "NCZ_XSHADERTOY_CHITIN_RANDOMIZE"
    },
    {
      "id": "quality",
      "type": "enum",
      "label": "Quality",
      "default": "auto",
      "choices": [
        "auto",
        "low",
        "medium",
        "high"
      ],
      "group": "System",
      "level": "advanced",
      "description": "Detail tier. auto follows the GPU class of this machine (NCZ_SHADER_QUALITY still overrides it).",
      "env": "NCZ_XSHADERTOY_CHITIN_QUALITY"
    },
    {
      "id": "seed",
      "type": "int",
      "label": "Random seed",
      "default": 0,
      "range": [
        0,
        999999
      ],
      "group": "System",
      "level": "basic",
      "description": "Fixes the run's randomness so it can be replayed exactly (same options). 0 = a new seed (1 to 999999) every run; the seed in use is logged.",
      "env": "NCZ_XSHADERTOY_CHITIN_SEED"
    }
  ]
}
