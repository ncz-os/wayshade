    {
      "id": "palette-cycle",
      "type": "float",
      "label": "Palette cycle (min)",
      "default": 0.0,
      "range": [
        0.0,
        60.0
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Minutes between slow cross-fades to another palette of the same family (interpolated in Oklab: lightness moves steadily from one palette to the other, never through grey). 0 = keep one palette.",
      "env": "NCZ_XSHADERTOY_AURORA_PALETTE_CYCLE"
    },
    {
      "id": "speed",
      "type": "float",
      "label": "Speed",
      "default": 1.0,
      "range": [
        0.25,
        3.0
      ],
      "group": "Motion",
      "level": "basic",
      "description": "Time scale of every motion.",
      "env": "NCZ_XSHADERTOY_AURORA_SPEED"
    },
    {
      "id": "evolution",
      "type": "float",
      "label": "Evolution",
      "default": 1.0,
      "range": [
        0.0,
        3.0
      ],
      "group": "Motion",
      "level": "advanced",
      "description": "Pace of the slow director: seeded keyframes about every minute that change structure over minutes. 0 holds the opening structure.",
      "env": "NCZ_XSHADERTOY_AURORA_EVOLUTION"
    },
    {
      "id": "curtains",
      "type": "int",
      "label": "Curtains",
      "default": 3,
      "range": [
        1,
        3
      ],
      "group": "Simulation",
      "level": "advanced",
      "description": "Number of curtain sheets (quality 0 draws at most two).",
      "env": "NCZ_XSHADERTOY_AURORA_CURTAINS"
    },
    {
      "id": "activity",
      "type": "float",
      "label": "Activity",
      "default": 0.5,
      "range": [
        0.0,
        1.0
      ],
      "group": "Simulation",
      "level": "advanced",
      "description": "Strength of the folding flow and how fast the curtains ripple. Low is a quiet arc; high is a substorm.",
      "env": "NCZ_XSHADERTOY_AURORA_ACTIVITY"
    },
    {
      "id": "folds",
      "type": "float",
      "label": "Folds",
      "default": 0.5,
      "range": [
        0.0,
        1.0
      ],
      "group": "Simulation",
      "level": "advanced",
      "description": "Amplitude of the large bends in each curtain's lower edge.",
      "env": "NCZ_XSHADERTOY_AURORA_FOLDS"
    },
    {
      "id": "height",
      "type": "float",
      "label": "Curtain height",
      "default": 0.5,
      "range": [
        0.0,
        1.0
      ],
      "group": "Look",
      "level": "advanced",
      "description": "How far the light reaches up from the lower edge.",
      "env": "NCZ_XSHADERTOY_AURORA_HEIGHT"
    },
    {
      "id": "rays",
      "type": "float",
      "label": "Rays",
      "default": 0.6,
      "range": [
        0.0,
        1.0
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Strength of the fine vertical striations.",
      "env": "NCZ_XSHADERTOY_AURORA_RAYS"
    },
    {
      "id": "brightness",
      "type": "float",
      "label": "Brightness",
      "default": 1.0,
      "range": [
        0.4,
        1.6
      ],
      "group": "Look",
      "level": "advanced",
      "description": "Overall emission.",
      "env": "NCZ_XSHADERTOY_AURORA_BRIGHTNESS"
    },
    {
      "id": "horizon",
      "type": "bool",
      "label": "Horizon",
      "default": true,
      "group": "Look",
      "level": "advanced",
      "description": "A dark line of hills along the bottom of the frame.",
      "env": "NCZ_XSHADERTOY_AURORA_HORIZON"
    },
    {
      "id": "randomize",
      "type": "bool",
      "label": "Randomize",
      "default": true,
      "group": "System",
      "level": "advanced",
      "description": "Draw every option you have not set (and the palette) from the run seed, inside ranges chosen to stay coherent. Off: defaults.",
      "env": "NCZ_XSHADERTOY_AURORA_RANDOMIZE"
    },
    {
      "id": "quality",
      "type": "enum",
      "label": "Quality",
      "default": "auto",
      "choices": [
        "auto",
        "low",
        "medium",
        "high"
      ],
      "group": "System",
      "level": "advanced",
      "description": "Detail tier. auto follows the GPU class of this machine (NCZ_SHADER_QUALITY still overrides it).",
      "env": "NCZ_XSHADERTOY_AURORA_QUALITY"
    },
    {
      "id": "seed",
      "type": "int",
      "label": "Random seed",
      "default": 0,
      "range": [
        0,
        999999
      ],
      "group": "System",
      "level": "basic",
      "description": "Fixes the run's randomness so it can be replayed exactly (same options). 0 = a new seed (1 to 999999) every run; the seed in use is logged.",
      "env": "NCZ_XSHADERTOY_AURORA_SEED"
    }
  ]
}
