def render_still(
    hack_id,
    settings,
    size,
    out,
    at=12.0,
    steps=160,
    overrides=None,
    timeout=30.0,
    binary=None,
):
    """Render one frame of a hack to a PNG through its capture mode.

    Uses the stored options exactly like a start (plus overrides), a fixed seed
    when none is stored, the display GPU, and the capture options for a single
    frame at `size` with no supersampling. Returns (exit code, message). The
    capture happens before the hack's first buffer is attached, so nothing is
    shown on screen. Exit codes: 0 rendered, 1 unknown or missing hack, 2 bad
    arguments, 4 the hack has no capture mode, 5 the render failed or timed out.
    """
    schema = {r["name"]: r for r in load_option_schema(hack_id)}
    if not schema or not still_supported(schema):
        return 4, f"{hack_id} cannot render a still"
    m = STILL_SIZE_RE.match(str(size))
    if not m or not (16 <= int(m.group(1)) <= 1920 and 16 <= int(m.group(2)) <= 1920):
        return 2, f"bad size {size!r} (WIDTHxHEIGHT, 16 to 1920)"
    binary = binary or find_binary(hack_id)
    if not binary:
        return 1, f"{hack_id} is not installed"
    options = dict(overrides or {})
    stored = stored_options(settings).get(hack_id, {})
    if "seed" in schema and "seed" not in options and "seed" not in stored:
        options["seed"] = str(STILL_SEED)
    out = Path(out)
    with contextlib.suppress(OSError):
        out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(out.name + ".part.png")
    options.update(
        {
            "capture": str(tmp),
            "capture-size": size,
            "capture-frames": "1",
            "capture-supersample": "1",
            "capture-steps": str(int(steps)),
            "capture-at": f"{float(at):g}",
        }
    )
    env = build_child_env(hack_id, settings, offload=False, options=options)
    env.pop("NCZ_SCREENSAVER_ACTIVE", None)
    # No Wayland surface at all: the harness renders surfaceless and the hack's
    # capture mode writes its own framebuffer, so nothing flashes or takes focus.
    env["NCZ_HARNESS_HEADLESS"] = size
    try:
        proc = subprocess.run(
            [binary],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        with contextlib.suppress(OSError):
            tmp.unlink()
        return 5, f"{hack_id} still timed out after {timeout:g} s"
    except OSError as exc:
        return 5, f"cannot run {binary}: {exc}"
    if not tmp.is_file():
        tail = proc.stderr.decode(errors="replace").strip().splitlines()[-1:] if proc.stderr else []
        return 5, f"{hack_id} still failed (exit {proc.returncode}){': ' + tail[0] if tail else ''}"
    try:
        os.replace(tmp, out)
    except OSError as exc:
        return 5, f"cannot write {out}: {exc}"
    return 0, str(out)


def cmd_still(args):
    """Render one frame of a hack with its current options to a PNG (front-end previews)."""
    settings, _ = load_settings()
    catalog = load_catalog()
    if not ID_RE.match(args.hack) or not known_id(args.hack, catalog):
        log(f"unknown hack {args.hack}")
        return 1
    out = args.out or (runtime_dir() / f"still-{args.hack}.png")
    code, msg = render_still(
        args.hack,
        settings,
        args.size,
        out,
        at=args.at,
        steps=args.steps,
        overrides=parse_option_args(args.option or []),
        timeout=args.timeout,
    )
    if code == 0:
        print(msg)
    else:
        log(msg)
    return code


