    else:
        for g in rows:
            role = "display" if g["display"] else "offload"
            ms = f"{g['ms']:.1f} ms" if g.get("ms") else "no score"
            cls = g.get("class") or "-"
            print(
                f"{g['index']:<5} {g['id']} {g['vendor']:<7} {g['driver']:<8} "
                f"{cls:<6} {role:<8} {ms}"
            )
    return 0


